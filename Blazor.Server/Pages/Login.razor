@page "/login"
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>@GetPageTitle()</PageTitle>

<div class="win-form win-form-narrow">
    <!-- Barra de Título Windows -->
    <div class="win-titlebar">
        <div class="d-flex align-items-center gap-1">
            <span class="oi @GetTitleIcon() text-primary win-title-icon"></span>
            <span>@GetPageTitle()</span>
        </div>
    </div>

    <!-- Contenido del Formulario -->
    <div class="win-form-content login-body">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="win-error-msg text-center mb-3">
                <span class="oi oi-warning me-1"></span> @errorMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="text-center mb-3 login-success-banner">
                <span class="oi oi-check me-1"></span> @successMessage
            </div>
        }

        @if (vistaActual == VistaLogin.Login)
        {
            <!-- Formulario de Inicio de Sesión -->
            <div class="text-center mb-1">
                <label class="win-label fw-bold">Nombre de usuario o correo</label>
            </div>
            <div class="text-center mb-3">
                <input type="text" class="win-textbox text-center login-input @(usernameInvalido ? "win-field-error" : "")" 
                       @bind="username" @onkeydown="HandleKeyDown" autofocus />
            </div>

            <div class="text-center mb-1">
                <label class="win-label fw-bold">Contraseña</label>
            </div>
            <div class="text-center mb-2">
                <input type="password" class="win-textbox text-center login-input @(passwordInvalido ? "win-field-error" : "")" 
                       @bind="password" @onkeydown="HandleKeyDown" />
            </div>
            <div class="text-center mb-3">
                <a href="javascript:void(0)" class="text-decoration-none login-link" @onclick="MostrarRecuperarPaso1">
                    ¿Olvidaste tu contraseña?
                </a>
            </div>

            <!-- Botones de Acción: Cancelar e Iniciar sesión -->
            <div class="d-flex justify-content-between px-3 mb-3">
                <button type="button" class="win-btn login-btn-md" @onclick="Limpiar" disabled="@isLoading">
                    Cancelar
                </button>
                <button type="button" class="win-btn login-btn-md" @onclick="IniciarSesion" disabled="@isLoading">
                    @(isLoading ? "Iniciando..." : "Iniciar sesión")
                </button>
            </div>

            <!-- Opción para registrarse como Lector o entrar como invitado -->
            <div class="text-center pt-2 d-flex justify-content-center align-items-center gap-3 login-divider">
                <a href="javascript:void(0)" class="text-decoration-none login-link" @onclick="MostrarRegistroLector">
                    ¿No tienes una cuenta? Registrarse como Lector
                </a>
                <span class="text-muted win-text-sm">|</span>
                <NavLink href="/" class="text-decoration-none login-link">
                    Continuar como invitado
                </NavLink>
            </div>
        }
        else if (vistaActual == VistaLogin.RegistroLector)
        {
            <!-- Formulario de Registro de Lector -->
            <div class="text-center mb-1">
                <label class="win-label fw-bold">Correo electrónico</label>
            </div>
            <div class="text-center mb-3">
                <input type="email" class="win-textbox text-center login-input @(regCorreoInvalido ? "win-field-error" : "")" 
                       @bind="regCorreo" placeholder="ejemplo@correo.com" autofocus />
            </div>

            <div class="text-center mb-1">
                <label class="win-label fw-bold">Contraseña</label>
            </div>
            <div class="text-center mb-3">
                <input type="password" class="win-textbox text-center login-input @(regPasswordInvalido ? "win-field-error" : "")" 
                       @bind="regPassword" />
            </div>

            <div class="text-center mb-1">
                <label class="win-label fw-bold">Confirmar contraseña</label>
            </div>
            <div class="text-center mb-3">
                <input type="password" class="win-textbox text-center login-input @(regConfirmInvalido ? "win-field-error" : "")" 
                       @bind="regConfirmPassword" />
            </div>

            <div class="text-center mb-4">
                <label class="win-check-label">
                    <input type="checkbox" @bind="regRecibirNotificaciones" class="win-check-input" />
                    Recibir notificaciones del Bestiario
                </label>
            </div>

            <!-- Botones de Acción de Registro -->
            <div class="d-flex justify-content-between px-3 mb-3">
                <button type="button" class="win-btn login-btn-md" @onclick="VolverALogin" disabled="@isLoading">
                    Volver
                </button>
                <button type="button" class="win-btn login-btn-lg" @onclick="RegistrarLector" disabled="@isLoading">
                    @(isLoading ? "Creando cuenta..." : "Crear y Entrar")
                </button>
            </div>

            <div class="text-center pt-2 login-divider">
                <a href="javascript:void(0)" class="text-decoration-none login-link" @onclick="VolverALogin">
                    ¿Ya tienes una cuenta? Iniciar sesión
                </a>
            </div>
        }
        else if (vistaActual == VistaLogin.RecuperarPaso1)
        {
            <!-- Paso 1: Solicitar código de verificación por Gmail -->
            <p class="text-muted text-center mb-3 win-text-sm">
                Ingresá tu correo electrónico y te enviaremos un código de verificación para restablecer tu contraseña.
            </p>

            <div class="text-center mb-1">
                <label class="win-label fw-bold">Correo electrónico</label>
            </div>
            <div class="text-center mb-4">
                <input type="email" class="win-textbox text-center login-input @(recCorreoInvalido ? "win-field-error" : "")"
                       @bind="recCorreo" placeholder="ejemplo@correo.com" @onkeydown="HandleKeyDown" autofocus />
            </div>

            <div class="d-flex justify-content-between px-3 mb-3">
                <button type="button" class="win-btn login-btn-md" @onclick="VolverALogin" disabled="@isLoading">
                    Volver
                </button>
                <button type="button" class="win-btn login-btn-lg" @onclick="EnviarCodigoRecuperacion" disabled="@isLoading">
                    @(isLoading ? "Enviando..." : "Enviar código")
                </button>
            </div>

            <div class="text-center pt-2 login-divider">
                <a href="javascript:void(0)" class="text-decoration-none login-link" @onclick="() => vistaActual = VistaLogin.RecuperarPaso2">
                    Ya tengo un código de verificación
                </a>
            </div>
        }
        else if (vistaActual == VistaLogin.RecuperarPaso2)
        {
            <!-- Paso 2: Ingresar código y nueva contraseña -->
            <div class="text-center mb-1">
                <label class="win-label fw-bold">Correo electrónico</label>
            </div>
            <div class="text-center mb-2">
                <input type="email" class="win-textbox text-center login-input @(recCorreoInvalido ? "win-field-error" : "")"
                       @bind="recCorreo" placeholder="ejemplo@correo.com" />
            </div>

            <div class="text-center mb-1">
                <label class="win-label fw-bold">Código de verificación (6 dígitos)</label>
            </div>
            <div class="text-center mb-2">
                <input type="text" class="win-textbox text-center login-code-input @(recCodigoInvalido ? "win-field-error" : "")"
                       maxlength="6" @bind="recCodigo" placeholder="000000" autofocus />
            </div>

            <div class="text-center mb-1">
                <label class="win-label fw-bold">Nueva contraseña</label>
            </div>
            <div class="text-center mb-2">
                <input type="password" class="win-textbox text-center login-input @(recPasswordInvalido ? "win-field-error" : "")"
                       @bind="recNuevaPassword" />
            </div>

            <div class="text-center mb-1">
                <label class="win-label fw-bold">Confirmar nueva contraseña</label>
            </div>
            <div class="text-center mb-4">
                <input type="password" class="win-textbox text-center login-input @(recConfirmInvalido ? "win-field-error" : "")"
                       @bind="recConfirmPassword" @onkeydown="HandleKeyDown" />
            </div>

            <div class="d-flex justify-content-between px-3 mb-3">
                <button type="button" class="win-btn login-btn-sm" @onclick="MostrarRecuperarPaso1" disabled="@isLoading">
                    Volver
                </button>
                <button type="button" class="win-btn login-btn-xl" @onclick="ConfirmarRestablecimiento" disabled="@isLoading">
                    @(isLoading ? "Guardando..." : "Restablecer contraseña")
                </button>
            </div>

            <div class="text-center pt-2 login-divider">
                <a href="javascript:void(0)" class="text-decoration-none login-link" @onclick="VolverALogin">
                    Volver al inicio de sesión
                </a>
            </div>
        }
    </div>
</div>

@code {
    private enum VistaLogin
    {
        Login,
        RegistroLector,
        RecuperarPaso1,
        RecuperarPaso2
    }

    private VistaLogin vistaActual = VistaLogin.Login;

    private string username = "admin@bestiario.com";
    private string password = "password";
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading = false;
    private bool usernameInvalido = false;
    private bool passwordInvalido = false;

    // Variables de Registro de Lector
    private string regCorreo = "";
    private string regPassword = "";
    private string regConfirmPassword = "";
    private bool regRecibirNotificaciones = true;
    private bool regCorreoInvalido = false;
    private bool regPasswordInvalido = false;
    private bool regConfirmInvalido = false;

    // Variables de Recuperación de Contraseña
    private string recCorreo = "";
    private string recCodigo = "";
    private string recNuevaPassword = "";
    private string recConfirmPassword = "";
    private bool recCorreoInvalido = false;
    private bool recCodigoInvalido = false;
    private bool recPasswordInvalido = false;
    private bool recConfirmInvalido = false;

    private string GetPageTitle() => vistaActual switch
    {
        VistaLogin.RegistroLector => "Registro de Lector",
        VistaLogin.RecuperarPaso1 => "Recuperar contraseña",
        VistaLogin.RecuperarPaso2 => "Restablecer contraseña",
        _ => "Iniciar sesión"
    };

    private string GetTitleIcon() => vistaActual switch
    {
        VistaLogin.RegistroLector => "oi-person",
        VistaLogin.RecuperarPaso1 or VistaLogin.RecuperarPaso2 => "oi-envelope-closed",
        _ => "oi-key"
    };

    private void MostrarRegistroLector()
    {
        vistaActual = VistaLogin.RegistroLector;
        errorMessage = null;
        successMessage = null;
        regCorreo = "";
        regPassword = "";
        regConfirmPassword = "";
        regRecibirNotificaciones = true;
        regCorreoInvalido = false;
        regPasswordInvalido = false;
        regConfirmInvalido = false;
    }

    private void MostrarRecuperarPaso1()
    {
        vistaActual = VistaLogin.RecuperarPaso1;
        errorMessage = null;
        successMessage = null;
        if (string.IsNullOrWhiteSpace(recCorreo) && username.Contains('@'))
        {
            recCorreo = username.Trim();
        }
        recCodigo = "";
        recNuevaPassword = "";
        recConfirmPassword = "";
        recCorreoInvalido = false;
        recCodigoInvalido = false;
        recPasswordInvalido = false;
        recConfirmInvalido = false;
    }

    private void VolverALogin()
    {
        vistaActual = VistaLogin.Login;
        errorMessage = null;
        successMessage = null;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            switch (vistaActual)
            {
                case VistaLogin.RegistroLector:
                    await RegistrarLector();
                    break;
                case VistaLogin.RecuperarPaso1:
                    await EnviarCodigoRecuperacion();
                    break;
                case VistaLogin.RecuperarPaso2:
                    await ConfirmarRestablecimiento();
                    break;
                default:
                    await IniciarSesion();
                    break;
            }
        }
    }

    private async Task IniciarSesion()
    {
        usernameInvalido = string.IsNullOrWhiteSpace(username);
        passwordInvalido = string.IsNullOrWhiteSpace(password);

        if (usernameInvalido)
        {
            errorMessage = "El nombre de usuario es requerido";
            return;
        }

        if (passwordInvalido)
        {
            errorMessage = "La contraseña es requerida";
            return;
        }

        try
        {
            isLoading = true;
            errorMessage = null;
            successMessage = null;

            bool ok = await Auth.LoginAsync(username, password);
            if (ok)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = "Usuario o contraseña incorrectos.";
                password = "";
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RegistrarLector()
    {
        regCorreoInvalido = string.IsNullOrWhiteSpace(regCorreo) || !regCorreo.Contains("@");
        regPasswordInvalido = string.IsNullOrWhiteSpace(regPassword);
        regConfirmInvalido = string.IsNullOrWhiteSpace(regConfirmPassword) || regPassword != regConfirmPassword;

        if (regCorreoInvalido)
        {
            errorMessage = "Ingrese un correo electrónico válido.";
            return;
        }

        if (regPasswordInvalido)
        {
            errorMessage = "La contraseña es requerida.";
            return;
        }

        if (regConfirmInvalido)
        {
            errorMessage = "Las contraseñas no coinciden.";
            return;
        }

        try
        {
            isLoading = true;
            errorMessage = null;

            bool ok = await Auth.RegistrarLectorAsync(regCorreo.Trim(), regPassword, regRecibirNotificaciones);
            if (ok)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = "No se pudo registrar la cuenta. Verifique los datos ingresados.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task EnviarCodigoRecuperacion()
    {
        recCorreoInvalido = string.IsNullOrWhiteSpace(recCorreo) || !recCorreo.Contains('@');
        if (recCorreoInvalido)
        {
            errorMessage = "Ingrese un correo electrónico válido.";
            return;
        }

        try
        {
            isLoading = true;
            errorMessage = null;
            successMessage = null;

            await UsuarioApiClient.SolicitarRecuperacionAsync(recCorreo.Trim());
            vistaActual = VistaLogin.RecuperarPaso2;
            successMessage = "Si el correo está registrado, enviamos un código de 6 dígitos a tu casilla.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmarRestablecimiento()
    {
        recCorreoInvalido = string.IsNullOrWhiteSpace(recCorreo) || !recCorreo.Contains('@');
        recCodigoInvalido = string.IsNullOrWhiteSpace(recCodigo);
        recPasswordInvalido = string.IsNullOrWhiteSpace(recNuevaPassword);
        recConfirmInvalido = string.IsNullOrWhiteSpace(recConfirmPassword) || recNuevaPassword != recConfirmPassword;

        if (recCorreoInvalido)
        {
            errorMessage = "Ingrese un correo electrónico válido.";
            return;
        }
        if (recCodigoInvalido)
        {
            errorMessage = "Ingrese el código de verificación recibido.";
            return;
        }
        if (recPasswordInvalido)
        {
            errorMessage = "Ingrese la nueva contraseña.";
            return;
        }
        if (recConfirmInvalido)
        {
            errorMessage = "Las contraseñas no coinciden.";
            return;
        }

        try
        {
            isLoading = true;
            errorMessage = null;
            successMessage = null;

            await UsuarioApiClient.RestablecerContraseniaAsync(recCorreo.Trim(), recCodigo.Trim(), recNuevaPassword);
            username = recCorreo.Trim();
            password = "";
            vistaActual = VistaLogin.Login;
            successMessage = "Contraseña restablecida correctamente. Ya podés iniciar sesión.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override void OnInitialized()
    {
        if (Auth.IsAuthenticated)
        {
            Navigation.NavigateTo("/");
        }
    }

    private void Limpiar()
    {
        username = "";
        password = "";
        successMessage = null;
        errorMessage = "Debe ingresar sus credenciales para acceder al sistema.";
    }
}

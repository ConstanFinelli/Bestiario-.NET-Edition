@page "/registros"
@inject NavigationManager Navigation
@inject AuthService Auth

<PageTitle>Registros</PageTitle>

<div class="win-form" style="width: 920px;">
    <!-- Barra de Título Windows -->
    <div class="win-titlebar">
        <div class="d-flex align-items-center gap-1">
            <span class="oi oi-list text-primary"></span>
            <span>Registros de Bestias</span>
        </div>
    </div>

    <!-- MenuStrip de Navegación -->
    <div class="win-menustrip">
        <NavLink href="/" class="win-menu-item">
            Inicio
        </NavLink>
        <NavLink href="/categorias" class="win-menu-item">
            Categorias
        </NavLink>
        <NavLink href="/noticias" class="win-menu-item">
            Noticias
        </NavLink>
        <NavLink href="/bestias" class="win-menu-item">
            Bestias
        </NavLink>
        <NavLink href="/registros" class="win-menu-item active">
            Registros
        </NavLink>
        <div class="ms-auto">
            <button class="win-btn" style="height: 20px; font-size: 11px; padding: 0 6px;" @onclick="CargarDatos" disabled="@isLoading">
                Refrescar
            </button>
        </div>
    </div>

    <!-- Contenido del Formulario -->
    <div class="win-form-content">
        @if (!string.IsNullOrEmpty(feedbackMessage))
        {
            <div class="@(isFeedbackError ? "win-error-msg" : "alert alert-success py-1 mb-2")" style="font-size: 11px;">
                @feedbackMessage
            </div>
        }

        <!-- Selector de Bestia para filtrar registros -->
        <div class="d-flex align-items-center gap-2 mb-2 p-2 bg-light border">
            <label class="win-label fw-bold mb-0">Filtrar por Bestia:</label>
            <select class="win-textbox" style="min-width: 250px;" @onchange="OnBestiaSeleccionadaCambiada">
                <option value="">-- Todas las Bestias --</option>
                @foreach (var b in bestias)
                {
                    <option value="@b.Id" selected="@(selectedFiltroBestiaId == b.Id)">@b.Nombre (@b.Peligrosidad)</option>
                }
            </select>
            @if (selectedFiltroBestiaId.HasValue)
            {
                <button class="win-btn" style="height: 22px; font-size: 11px;" @onclick="LimpiarFiltro">
                    Quitar Filtro
                </button>
            }
        </div>

        <!-- Grilla DataGridView de Registros -->
        <div class="win-grid-container" style="height: 260px;">
            <table class="win-grid">
                <thead>
                    <tr>
                        <th class="win-grid-row-header-th"></th>
                        <th style="width: 140px;">Bestia</th>
                        <th style="width: 60px; text-align: center;">Nro</th>
                        <th style="width: 90px; text-align: center;">Estado</th>
                        <th style="width: 150px;">Publicado por</th>
                        <th style="width: 150px;">Aprobado por</th>
                        <th style="width: 70px; text-align: center;">Secciones</th>
                        <th>Fecha Aprobación</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                Cargando registros...
                            </td>
                        </tr>
                    }
                    else if (registrosMostrados == null || !registrosMostrados.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No se encontraron registros para la selección actual.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in registrosMostrados)
                        {
                            bool isSelected = selectedRegistro?.IdBestia == r.IdBestia && selectedRegistro?.NroRegistro == r.NroRegistro;
                            var nombreBestia = bestias.FirstOrDefault(b => b.Id == r.IdBestia)?.Nombre ?? r.IdBestia.ToString().Substring(0, 8);
                            <tr class="@(isSelected ? "selected" : "")" 
                                @onclick="() => SeleccionarFila(r)"
                                @ondblclick="AbrirModalActualizar">
                                <td class="win-grid-row-header">
                                    @(isSelected ? "▶" : "")
                                </td>
                                <td><strong>@nombreBestia</strong></td>
                                <td style="text-align: center; font-weight: bold;">@r.NroRegistro</td>
                                <td style="text-align: center;">
                                    <span class="badge @(r.Estado == "aprobado" ? "bg-success" : "bg-warning text-dark")" style="font-size: 10px;">
                                        @r.Estado
                                    </span>
                                </td>
                                <td style="font-size: 11px;">@(r.CorreoPublicador ?? "N/A")</td>
                                <td style="font-size: 11px;">@(r.NombreInvestigadorAprobador ?? "-")</td>
                                <td style="text-align: center; font-size: 11px;">@r.Contenidos.Count</td>
                                <td style="font-size: 11px;">@(r.FechaAprobacion?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Botones de Acción -->
        <div class="win-btn-action-bar">
            @if (Auth.EsInvestigador && selectedRegistro != null && selectedRegistro.Estado == "pendiente")
            {
                <button class="win-btn btn-success me-auto" style="border-color: #2e6b2e;" @onclick="AprobarRegistroSeleccionado" disabled="@isLoading">
                    ✔ Aprobar Registro
                </button>
            }
            @if (Auth.EsInvestigador)
            {
                <button class="win-btn" @onclick="AbrirModalEliminar" disabled="@(selectedRegistro == null || isLoading)">
                    Eliminar
                </button>
                <button class="win-btn" @onclick="AbrirModalActualizar" disabled="@(selectedRegistro == null || isLoading)">
                    Ver / Editar
                </button>
                <button class="win-btn" @onclick="AbrirModalAgregar" disabled="@isLoading">
                    Agregar
                </button>
            }
            else
            {
                <button class="win-btn" @onclick="AbrirModalActualizar" disabled="@(selectedRegistro == null || isLoading)">
                    Ver Detalle
                </button>
            }
        </div>
    </div>

    <!-- Barra de Estado Inferior -->
    <div class="win-statusbar">
        <span>@(registrosMostrados?.Count ?? 0) registro(s) encontrado(s)</span>
        <span>@(selectedRegistro != null ? $"Seleccionado: Registro #{selectedRegistro.NroRegistro}" : "Ningún registro seleccionado")</span>
    </div>
</div>

<!-- Modal Detalle Maestro/Detalle -->
<RegistroModal IsOpen="@isModalOpen" 
               Mode="@modalMode" 
               Registro="@registroParaEditar" 
               Bestias="@bestias" 
               OnSaved="@OnRegistroGuardado" 
               OnCancel="@CerrarModal" />

<!-- Diálogo Confirmación Eliminación -->
<ConfirmModal IsOpen="@isConfirmDeleteOpen"
              Title="Confirmar eliminación"
              Message="@($"¿Está seguro que desea eliminar el registro #{selectedRegistro?.NroRegistro}?")"
              ConfirmButtonText="Sí"
              OnConfirm="@EliminarRegistroConfirmado"
              OnCancel="@(() => isConfirmDeleteOpen = false)" />

@implements IDisposable

@code {
    [SupplyParameterFromQuery]
    public Guid? BestiaId { get; set; }

    private List<BestiaDTO> bestias = new();
    private List<RegistroDTO> todosRegistros = new();
    private List<RegistroDTO> registrosMostrados = new();

    private RegistroDTO? selectedRegistro;
    private RegistroDTO registroParaEditar = new();
    private FormMode modalMode = FormMode.Add;

    private Guid? selectedFiltroBestiaId;
    private bool isLoading = true;
    private bool isModalOpen = false;
    private bool isConfirmDeleteOpen = false;

    private string? feedbackMessage;
    private bool isFeedbackError = false;

    protected override async Task OnInitializedAsync()
    {
        Auth.OnChange += HandleAuthStateChanged;

        if (BestiaId.HasValue && BestiaId.Value != Guid.Empty)
        {
            selectedFiltroBestiaId = BestiaId.Value;
        }

        await CargarDatos();
    }

    private async void HandleAuthStateChanged()
    {
        await InvokeAsync(async () =>
        {
            await CargarDatos();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Auth.OnChange -= HandleAuthStateChanged;
    }

    private async Task CargarDatos()
    {
        try
        {
            isLoading = true;
            feedbackMessage = null;
            selectedRegistro = null;

            var beastsResult = await BestiaApiClient.GetAllAsync();
            bestias = beastsResult?.ToList() ?? new List<BestiaDTO>();
            if (!Auth.EsInvestigador)
            {
                bestias = bestias.Where(b => b.Estado != null && b.Estado.Equals("aprobado", StringComparison.OrdinalIgnoreCase)).ToList();
            }

            todosRegistros = new List<RegistroDTO>();

            // Cargar registros para cada bestia
            foreach (var b in bestias)
            {
                var regs = await RegistroApiClient.GetByBestiaAsync(b.Id);
                if (regs != null)
                {
                    todosRegistros.AddRange(regs);
                }
            }

            if (!Auth.EsInvestigador)
            {
                todosRegistros = todosRegistros.Where(r => r.Estado != null && r.Estado.Equals("aprobado", StringComparison.OrdinalIgnoreCase)).ToList();
            }

            AplicarFiltro();
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al cargar registros: {ex.Message}";
            isFeedbackError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnBestiaSeleccionadaCambiada(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (Guid.TryParse(val, out Guid id))
        {
            selectedFiltroBestiaId = id;
        }
        else
        {
            selectedFiltroBestiaId = null;
        }
        AplicarFiltro();
    }

    private void LimpiarFiltro()
    {
        selectedFiltroBestiaId = null;
        AplicarFiltro();
    }

    private void AplicarFiltro()
    {
        if (selectedFiltroBestiaId.HasValue)
        {
            registrosMostrados = todosRegistros
                .Where(r => r.IdBestia == selectedFiltroBestiaId.Value)
                .OrderBy(r => r.NroRegistro)
                .ToList();
        }
        else
        {
            registrosMostrados = todosRegistros
                .OrderBy(r => r.IdBestia)
                .ThenBy(r => r.NroRegistro)
                .ToList();
        }

        selectedRegistro = registrosMostrados.FirstOrDefault();
    }

    private void SeleccionarFila(RegistroDTO r)
    {
        selectedRegistro = r;
    }

    private void AbrirModalAgregar()
    {
        modalMode = FormMode.Add;
        registroParaEditar = new RegistroDTO
        {
            IdBestia = selectedFiltroBestiaId ?? (bestias.FirstOrDefault()?.Id ?? Guid.Empty),
            Estado = "pendiente",
            Contenidos = new List<ContenidoRegistroDTO>()
        };
        isModalOpen = true;
    }

    private async Task AbrirModalActualizar()
    {
        if (selectedRegistro == null) return;

        try
        {
            isLoading = true;
            var fresco = await RegistroApiClient.GetAsync(selectedRegistro.IdBestia, selectedRegistro.NroRegistro);
            if (fresco != null)
            {
                registroParaEditar = new RegistroDTO
                {
                    IdBestia = fresco.IdBestia,
                    NroRegistro = fresco.NroRegistro,
                    FechaAprobacion = fresco.FechaAprobacion,
                    FechaBaja = fresco.FechaBaja,
                    IdUsuarioPublicador = fresco.IdUsuarioPublicador,
                    CorreoPublicador = fresco.CorreoPublicador,
                    IdInvestigadorAprobador = fresco.IdInvestigadorAprobador,
                    NombreInvestigadorAprobador = fresco.NombreInvestigadorAprobador,
                    Estado = fresco.Estado,
                    Contenidos = fresco.Contenidos.Select(c => new ContenidoRegistroDTO
                    {
                        IdBestia = c.IdBestia,
                        NroRegistro = c.NroRegistro,
                        NroContenido = c.NroContenido,
                        Titulo = c.Titulo,
                        Contenido = c.Contenido
                    }).ToList()
                };
                modalMode = FormMode.Update;
                isModalOpen = true;
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al obtener datos: {ex.Message}";
            isFeedbackError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CerrarModal()
    {
        isModalOpen = false;
    }

    private async Task OnRegistroGuardado()
    {
        isModalOpen = false;
        feedbackMessage = "Registro guardado exitosamente.";
        isFeedbackError = false;
        await CargarDatos();
    }

    private void AbrirModalEliminar()
    {
        if (selectedRegistro != null)
        {
            isConfirmDeleteOpen = true;
        }
    }

    private async Task EliminarRegistroConfirmado()
    {
        if (selectedRegistro == null) return;

        try
        {
            isConfirmDeleteOpen = false;
            isLoading = true;
            await RegistroApiClient.DeleteAsync(selectedRegistro.IdBestia, selectedRegistro.NroRegistro);
            feedbackMessage = $"Registro #{selectedRegistro.NroRegistro} eliminado.";
            isFeedbackError = false;
            selectedRegistro = null;
            await CargarDatos();
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al eliminar registro: {ex.Message}";
            isFeedbackError = true;
            isLoading = false;
        }
    }

    private async Task AprobarRegistroSeleccionado()
    {
        if (selectedRegistro == null) return;

        try
        {
            isLoading = true;
            var investigadorId = Auth.CurrentUser?.Id ?? Guid.Parse("99999999-9999-9999-9999-999999999999");
            await RegistroApiClient.AprobarAsync(selectedRegistro.IdBestia, selectedRegistro.NroRegistro, investigadorId);
            feedbackMessage = $"Registro #{selectedRegistro.NroRegistro} aprobado con éxito.";
            isFeedbackError = false;
            await CargarDatos();
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al aprobar registro: {ex.Message}";
            isFeedbackError = true;
            isLoading = false;
        }
    }
}

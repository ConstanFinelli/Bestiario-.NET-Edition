@inject AuthService Auth

@if (IsOpen)
{
    <div class="win-modal-overlay">
        <div class="win-modal-dialog" style="width: @(isEditMode ? "640px" : "900px"); max-width: 95vw;">
            <!-- Barra de Título del Diálogo -->
            <div class="win-titlebar">
                <div class="d-flex align-items-center gap-1">
                    <span class="oi @(isEditMode ? "oi-window" : "oi-book") text-primary" style="font-size: 11px;"></span>
                    <span>@(isEditMode ? "Registro de Bestia (Maestro / Detalle)" : $"Enciclopedia — {bestiaActual?.Nombre ?? "Registro"}")</span>
                </div>
                <div class="win-titlebar-controls">
                    <button class="win-titlebar-btn close" title="Cerrar" @onclick="Cancel" disabled="@isSaving">✕</button>
                </div>
            </div>

            <!-- Cuerpo del Formulario / Enciclopedia -->
            <div class="win-form-content" style="padding: 16px 20px; max-height: 84vh; overflow-y: auto;">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="win-error-msg mb-2">
                        <span class="oi oi-warning me-1"></span> @errorMessage
                    </div>
                }

                @if (!isEditMode && Mode == FormMode.Update)
                {
                    <!-- VISTA ENCICLOPEDIA -->
                    <div style="background-color: #f6f3eb; border: 1px solid #d5cfc0; padding: 20px 24px; border-radius: 3px;">
                        <!-- Encabezado con el nombre de la Bestia -->
                        <div style="font-family: Georgia, 'Times New Roman', serif; font-size: 24px; font-weight: bold; color: #2b2620; text-align: center; border-bottom: 1px solid #bdb6a7; padding-bottom: 8px; margin-bottom: 18px;">
                            @(bestiaActual?.Nombre ?? "Bestia")
                        </div>

                        <div class="row g-4">
                            <!-- Izquierda: Contenidos del Registro por secciones -->
                            <div class="col-md-8">
                                @if (!Registro.Contenidos.Any())
                                {
                                    <p class="text-muted fst-italic" style="font-size: 13px;">
                                        Este registro aún no posee secciones de contenido.
                                    </p>
                                }
                                else
                                {
                                    @foreach (var cont in Registro.Contenidos.OrderBy(c => c.NroContenido))
                                    {
                                        <section class="mb-3">
                                            <h5 style="font-family: Georgia, 'Times New Roman', serif; font-size: 16px; font-weight: bold; color: #2c2721; margin-bottom: 6px;">
                                                @cont.Titulo
                                            </h5>
                                            <p style="font-size: 13px; line-height: 1.65; color: #2e2e2e; white-space: pre-line; text-align: justify; margin-bottom: 0;">
                                                @cont.Contenido
                                            </p>
                                        </section>
                                    }
                                }
                            </div>

                            <!-- Derecha: Detalles de la Bestia y del Registro -->
                            <div class="col-md-4">
                                <div style="background-color: #e4e0d8; border: 1px solid #c9c3b6; border-radius: 6px; padding: 14px 12px; text-align: center;">
                                    <div style="font-family: Georgia, 'Times New Roman', serif; font-size: 14px; font-weight: bold; color: #2b2620; margin-bottom: 6px;">
                                        Detalles de la bestia
                                    </div>
                                    <div style="font-size: 12px; color: #333; margin-bottom: 2px;">
                                        <strong>Nombre:</strong> @(bestiaActual?.Nombre ?? "-")
                                    </div>
                                    <div style="font-size: 12px; color: #333; margin-bottom: 12px;">
                                        <strong>Peligrosidad:</strong>
                                        <span class="badge bg-secondary ms-1" style="font-size: 10px;">@(bestiaActual?.Peligrosidad ?? "-")</span>
                                    </div>

                                    <div style="font-family: Georgia, 'Times New Roman', serif; font-size: 13px; font-weight: bold; color: #2b2620; margin-bottom: 6px; border-top: 1px solid #ccc5b8; padding-top: 10px;">
                                        Categorías
                                    </div>
                                    <div class="d-flex flex-wrap justify-content-center gap-1 mb-3">
                                        @if (bestiaActual?.CategoriasNombres != null && bestiaActual.CategoriasNombres.Any())
                                        {
                                            @foreach (var cat in bestiaActual.CategoriasNombres)
                                            {
                                                <span class="badge bg-light text-dark border" style="font-size: 11px;">▶ @cat</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-size: 11px;">Sin categorías</span>
                                        }
                                    </div>

                                    <div style="font-family: Georgia, 'Times New Roman', serif; font-size: 13px; font-weight: bold; color: #2b2620; margin-bottom: 4px; border-top: 1px solid #ccc5b8; padding-top: 10px;">
                                        Hábitat localizado
                                    </div>
                                    <div style="font-size: 12px; color: #333; margin-bottom: 12px;">
                                        @(string.IsNullOrWhiteSpace(bestiaActual?.HabitatNombre) ? "Sin hábitat asignado" : bestiaActual.HabitatNombre)
                                    </div>

                                    <div style="font-family: Georgia, 'Times New Roman', serif; font-size: 13px; font-weight: bold; color: #2b2620; margin-bottom: 6px; border-top: 1px solid #ccc5b8; padding-top: 10px;">
                                        Detalles de registro
                                    </div>
                                    <div style="font-size: 11px; color: #333; line-height: 1.55;">
                                        <div><strong>Nro. Registro:</strong> #@Registro.NroRegistro</div>
                                        <div>
                                            <strong>Estado:</strong>
                                            <span class="badge @(Registro.Estado == "aprobado" ? "bg-success" : "bg-warning text-dark")" style="font-size: 10px;">
                                                @Registro.Estado
                                            </span>
                                        </div>
                                        <div><strong>Publicado por:</strong> @(Registro.CorreoPublicador ?? "N/A")</div>
                                        <div><strong>Aprobado por:</strong> @(Registro.NombreInvestigadorAprobador ?? "Pendiente")</div>
                                        @if (Registro.FechaAprobacion.HasValue)
                                        {
                                            <div><strong>Aprobación:</strong> @Registro.FechaAprobacion.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Abajo: Evidencias de la Bestia -->
                        <div class="mt-4 pt-3" style="border-top: 1px solid #bdb6a7;">
                            <div style="font-family: Georgia, 'Times New Roman', serif; font-size: 15px; font-weight: bold; color: #2b2620; margin-bottom: 8px;">
                                Evidencias registradas (@evidenciasBestia.Count)
                            </div>

                            @if (isLoadingEvidencias)
                            {
                                <div class="text-muted" style="font-size: 12px;">Cargando evidencias...</div>
                            }
                            else if (!evidenciasBestia.Any())
                            {
                                <div class="text-muted fst-italic" style="font-size: 12px;">
                                    No hay evidencias registradas para esta bestia.
                                </div>
                            }
                            else
                            {
                                <div class="row g-2">
                                    @foreach (var ev in evidenciasBestia)
                                    {
                                        <div class="col-md-6">
                                            <div class="p-2 border rounded" style="background-color: #ffffff; font-size: 11px;">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <strong>Evidencia #@ev.NroEvidencia — @(ev.TipoEvidenciaDescripcion ?? "Archivo")</strong>
                                                    <span class="badge @(ev.Estado == "aprobado" ? "bg-success" : "bg-warning text-dark")" style="font-size: 10px;">
                                                        @ev.Estado
                                                    </span>
                                                </div>
                                                <div class="text-muted" style="font-family: monospace;">
                                                    [@(ev.TipoEvidenciaResourceType ?? "-")] @ev.FileId
                                                </div>
                                                <div class="text-muted mt-1">
                                                    Obtenida: @ev.FechaObtencion.ToString("dd/MM/yyyy HH:mm")
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Barra inferior de la vista Enciclopedia -->
                    <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                        @if (Auth.EsInvestigador)
                        {
                            <button type="button" class="win-btn me-auto" @onclick="() => isEditMode = true">
                                ✎ Editar Registro
                            </button>
                        }
                        <button type="button" class="win-btn" @onclick="Cancel">
                            Cerrar
                        </button>
                    </div>
                }
                else
                {
                    <!-- MODO ALTA / EDICIÓN (MAESTRO / DETALLE) -->
                    @if (Auth.EsLector && Mode == FormMode.Add)
                    {
                        <div class="alert alert-info py-1 mb-2" style="font-size: 11px;">
                            Tu registro se enviará en estado <strong>pendiente</strong> para revisión de un investigador.
                        </div>
                    }

                    <!-- DATOS MAESTRO (Registro) -->
                    <fieldset style="border: 1px solid #c0c0c0; padding: 10px 14px; margin-bottom: 12px; background: #fafafa;">
                        <legend style="font-size: 11px; font-weight: bold; width: auto; padding: 0 4px; margin-bottom: 0;">
                            Datos Principales (Registro)
                        </legend>

                        <div class="row align-items-center mb-2">
                            <div class="col-3">
                                <label class="win-label">Bestia:</label>
                            </div>
                            <div class="col-9">
                                @if (Mode == FormMode.Update)
                                {
                                    var nombreBestia = Bestias.FirstOrDefault(b => b.Id == Registro.IdBestia)?.Nombre ?? Registro.IdBestia.ToString();
                                    <input type="text" class="win-textbox w-100" value="@nombreBestia" readonly />
                                }
                                else
                                {
                                    <select class="win-textbox w-100" @bind="Registro.IdBestia" disabled="@(isSaving || !PuedeEditar)">
                                        <option value="@Guid.Empty">-- Seleccione una Bestia --</option>
                                        @foreach (var b in Bestias)
                                        {
                                            <option value="@b.Id">@b.Nombre (@b.Peligrosidad)</option>
                                        }
                                    </select>
                                }
                            </div>
                        </div>

                        @if (Mode == FormMode.Update)
                        {
                            <div class="row align-items-center mb-2">
                                <div class="col-3">
                                    <label class="win-label">Nro. Registro:</label>
                                </div>
                                <div class="col-9">
                                    <input type="text" class="win-textbox" style="width: 100px;" value="@Registro.NroRegistro" readonly />
                                </div>
                            </div>
                        }

                        <div class="row align-items-center mb-2">
                            <div class="col-3">
                                <label class="win-label">Estado:</label>
                            </div>
                            <div class="col-9">
                                <select class="win-textbox" style="width: 140px;" @bind="Registro.Estado" disabled="@(isSaving || !Auth.EsInvestigador)">
                                    <option value="pendiente">pendiente</option>
                                    <option value="aprobado">aprobado</option>
                                </select>
                            </div>
                        </div>

                        @if (Mode == FormMode.Update)
                        {
                            <div class="row align-items-center mb-1">
                                <div class="col-3">
                                    <label class="win-label">Publicador:</label>
                                </div>
                                <div class="col-9">
                                    <span class="text-muted" style="font-size: 11px;">@(Registro.CorreoPublicador ?? "N/A")</span>
                                </div>
                            </div>

                            <div class="row align-items-center mb-1">
                                <div class="col-3">
                                    <label class="win-label">Aprobador:</label>
                                </div>
                                <div class="col-9">
                                    <span class="text-muted" style="font-size: 11px;">@(Registro.NombreInvestigadorAprobador ?? "Pendiente de aprobación")</span>
                                </div>
                            </div>

                            @if (Registro.FechaAprobacion.HasValue)
                            {
                                <div class="row align-items-center mb-1">
                                    <div class="col-3">
                                        <label class="win-label">Aprobado el:</label>
                                    </div>
                                    <div class="col-9">
                                        <span class="text-muted" style="font-size: 11px;">@Registro.FechaAprobacion.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                </div>
                            }
                        }
                    </fieldset>

                    <!-- DATOS DETALLE (Contenidos del Registro) -->
                    <fieldset style="border: 1px solid #c0c0c0; padding: 10px 14px; background: #fafafa;">
                        <legend style="font-size: 11px; font-weight: bold; width: auto; padding: 0 4px; margin-bottom: 0;">
                            Detalle de Contenidos (@Registro.Contenidos.Count)
                        </legend>

                        <!-- Grilla de Contenidos -->
                        <div class="win-grid-container mb-2" style="height: 140px;">
                            <table class="win-grid">
                                <thead>
                                    <tr>
                                        <th style="width: 35px;">#</th>
                                        <th style="width: 160px;">Título</th>
                                        <th>Contenido</th>
                                        <th style="width: 50px; text-align: center;">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Registro.Contenidos.Any())
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center py-2 text-muted">
                                                No hay secciones de contenido agregadas aún.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @for (int i = 0; i < Registro.Contenidos.Count; i++)
                                        {
                                            var idx = i;
                                            var cont = Registro.Contenidos[idx];
                                            <tr>
                                                <td style="font-size: 10px; font-weight: bold;">@cont.NroContenido</td>
                                                <td><strong>@cont.Titulo</strong></td>
                                                <td style="font-size: 11px;">@cont.Contenido</td>
                                                <td style="text-align: center;">
                                                    @if (PuedeEditar)
                                                    {
                                                        <button type="button" class="btn btn-outline-danger btn-sm p-0 px-1" 
                                                                style="font-size: 10px;" 
                                                                @onclick="() => EliminarContenido(idx)" 
                                                                disabled="@isSaving">
                                                            ✕
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (PuedeEditar)
                        {
                            <!-- Formulario para agregar un nuevo contenido detalle -->
                            <div style="background: #ffffff; border: 1px dashed #a0a0a0; padding: 8px 10px; border-radius: 2px;">
                                <span class="fw-bold d-block mb-1" style="font-size: 11px;">+ Agregar Nueva Sección al Registro:</span>
                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4">
                                        <input type="text" class="win-textbox w-100" placeholder="Título de la sección..." 
                                               @bind="nuevoTitulo" disabled="@isSaving" maxlength="100" />
                                    </div>
                                    <div class="col-6">
                                        <input type="text" class="win-textbox w-100" placeholder="Contenido o descripción..." 
                                               @bind="nuevoContenido" disabled="@isSaving" />
                                    </div>
                                    <div class="col-2 text-end">
                                        <button type="button" class="win-btn w-100" style="height: 24px; font-size: 11px;" 
                                                @onclick="AgregarContenido" disabled="@isSaving">
                                            Agregar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </fieldset>

                    <!-- Botones Aceptar / Cancelar -->
                    <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                        @if (Mode == FormMode.Update)
                        {
                            <button type="button" class="win-btn me-auto" @onclick="() => isEditMode = false" disabled="@isSaving">
                                ← Vista Enciclopedia
                            </button>
                        }
                        @if (PuedeEditar)
                        {
                            <button type="button" class="win-btn" @onclick="Save" disabled="@isSaving">
                                @(isSaving ? "Guardando..." : (Auth.EsInvestigador ? "Aceptar" : "Proponer"))
                            </button>
                        }
                        <button type="button" class="win-btn" @onclick="Cancel" disabled="@isSaving">
                            @(PuedeEditar ? "Cancelar" : "Cerrar")
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public FormMode Mode { get; set; } = FormMode.Add;
    [Parameter] public RegistroDTO Registro { get; set; } = new RegistroDTO();
    [Parameter] public List<BestiaDTO> Bestias { get; set; } = new List<BestiaDTO>();

    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool isSaving = false;
    private bool isEditMode = false;
    private bool wasOpen = false;
    private Guid? lastLoadedBestiaId;
    private int lastLoadedNroRegistro;
    private string? errorMessage;
    private bool PuedeEditar => Auth.EsInvestigador || (Auth.EsLector && Mode == FormMode.Add);

    private BestiaDTO? bestiaActual;
    private List<EvidenciaDTO> evidenciasBestia = new();
    private bool isLoadingEvidencias = false;

    private string nuevoTitulo = string.Empty;
    private string nuevoContenido = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen)
        {
            wasOpen = false;
            return;
        }

        if (Registro == null)
            Registro = new RegistroDTO();

        if (!Auth.EsInvestigador && Mode == FormMode.Add)
            Registro.Estado = "pendiente";
        else if (string.IsNullOrEmpty(Registro.Estado))
            Registro.Estado = "pendiente";

        bool recienAbierto = !wasOpen || lastLoadedBestiaId != Registro.IdBestia || lastLoadedNroRegistro != Registro.NroRegistro;
        wasOpen = true;

        if (recienAbierto)
        {
            errorMessage = null;
            nuevoTitulo = string.Empty;
            nuevoContenido = string.Empty;
            isEditMode = Mode == FormMode.Add;
            lastLoadedBestiaId = Registro.IdBestia;
            lastLoadedNroRegistro = Registro.NroRegistro;
            bestiaActual = Bestias.FirstOrDefault(b => b.Id == Registro.IdBestia);

            if (Mode == FormMode.Update && Registro.IdBestia != Guid.Empty)
            {
                await CargarEvidenciasBestiaAsync(Registro.IdBestia);
            }
            else
            {
                evidenciasBestia = new List<EvidenciaDTO>();
            }
        }
    }

    private async Task CargarEvidenciasBestiaAsync(Guid idBestia)
    {
        try
        {
            isLoadingEvidencias = true;
            var res = await EvidenciaApiClient.GetByBestiaAsync(idBestia);
            var lista = res?.ToList() ?? new List<EvidenciaDTO>();
            if (!Auth.EsInvestigador)
            {
                lista = lista.Where(e => e.Estado != null && e.Estado.Equals("aprobado", StringComparison.OrdinalIgnoreCase)).ToList();
            }
            evidenciasBestia = lista.OrderBy(e => e.NroEvidencia).ToList();
        }
        catch
        {
            evidenciasBestia = new List<EvidenciaDTO>();
        }
        finally
        {
            isLoadingEvidencias = false;
        }
    }

    private void AgregarContenido()
    {
        if (string.IsNullOrWhiteSpace(nuevoTitulo))
        {
            errorMessage = "El título de la sección de contenido es requerido.";
            return;
        }

        if (string.IsNullOrWhiteSpace(nuevoContenido))
        {
            errorMessage = "El texto de contenido es requerido.";
            return;
        }

        errorMessage = null;

        var proximoNro = Registro.Contenidos.Any() 
            ? Registro.Contenidos.Max(c => c.NroContenido) + 1 
            : 1;

        Registro.Contenidos.Add(new ContenidoRegistroDTO
        {
            IdBestia = Registro.IdBestia,
            NroRegistro = Registro.NroRegistro,
            NroContenido = proximoNro,
            Titulo = nuevoTitulo.Trim(),
            Contenido = nuevoContenido.Trim()
        });

        nuevoTitulo = string.Empty;
        nuevoContenido = string.Empty;
    }

    private void EliminarContenido(int index)
    {
        if (index >= 0 && index < Registro.Contenidos.Count)
        {
            Registro.Contenidos.RemoveAt(index);
            // Re-numerar correlativo 1..N
            for (int i = 0; i < Registro.Contenidos.Count; i++)
            {
                Registro.Contenidos[i].NroContenido = i + 1;
            }
        }
    }

    private bool ValidateInput()
    {
        if (Registro.IdBestia == Guid.Empty)
        {
            errorMessage = "Debe seleccionar una Bestia para el registro.";
            return false;
        }

        if (!Registro.Contenidos.Any())
        {
            errorMessage = "Debe agregar al menos una sección de contenido al registro.";
            return false;
        }

        errorMessage = null;
        return true;
    }

    private async Task Save()
    {
        if (!ValidateInput()) return;

        try
        {
            isSaving = true;
            errorMessage = null;

            // Asegurar que cada contenido tenga asignada la FK compuesta
            foreach (var c in Registro.Contenidos)
            {
                c.IdBestia = Registro.IdBestia;
                c.NroRegistro = Registro.NroRegistro;
            }

            if (Mode == FormMode.Add)
            {
                if (!Auth.EsInvestigador)
                {
                    Registro.Estado = "pendiente";
                }

                // Asignar publicador desde sesión si es nuevo
                if (Registro.IdUsuarioPublicador == Guid.Empty)
                {
                    Registro.IdUsuarioPublicador = Auth.CurrentUser?.Id ?? Guid.Parse("99999999-9999-9999-9999-999999999999");
                }

                await RegistroApiClient.AddAsync(Registro);
            }
            else
            {
                await RegistroApiClient.UpdateAsync(Registro);
            }

            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar registro: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }
}

@inject AuthService Auth

@if (IsOpen)
{
    <div class="win-modal-overlay">
        <div class="win-modal-dialog" style="width: @(isEditMode ? "640px" : "900px"); max-width: 95vw;">
            <!-- Barra de Título del Diálogo -->
            <div class="win-titlebar">
                <div class="d-flex align-items-center gap-1">
                    <span class="oi @(isEditMode ? "oi-window" : "oi-book") text-primary" style="font-size: 11px;"></span>
                    <span>@(isEditMode ? "Registro de Bestia (Maestro / Detalle)" : $"Enciclopedia — {bestiaActual?.Nombre ?? "Registro"}")</span>
                </div>
                <div class="win-titlebar-controls">
                    <button class="win-titlebar-btn close" title="Cerrar" @onclick="Cancel" disabled="@isSaving">✕</button>
                </div>
            </div>

            <!-- Cuerpo del Formulario / Enciclopedia -->
            <div class="win-form-content" style="padding: 16px 20px; max-height: 84vh; overflow-y: auto;">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="win-error-msg mb-2">
                        <span class="oi oi-warning me-1"></span> @errorMessage
                    </div>
                }

                @if (!isEditMode && Mode == FormMode.Update)
                {
                    <!-- VISTA ENCICLOPEDIA -->
                    <div style="background-color: #f6f3eb; border: 1px solid #d5cfc0; padding: 20px 24px; border-radius: 3px;">
                        <!-- Encabezado con el nombre de la Bestia -->
                        <div style="font-family: Georgia, 'Times New Roman', serif; font-size: 24px; font-weight: bold; color: #ffffff; background-color: #8E6E53; text-align: center; border-bottom: 1px solid #755840; padding: 10px 14px; border-radius: 3px; margin-bottom: 12px;">
                            @(bestiaActual?.Nombre ?? "Bestia")
                        </div>

                        <!-- Cargar registro en determinada fecha -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 p-2 rounded" style="background-color: #ebe6da; border: 1px solid #d0c9b8; font-size: 11px;">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="fw-bold" style="color: #2b2620;">Cargar registro en determinada fecha:</span>
                                <input type="datetime-local" class="win-textbox" style="height: 22px;" @bind="fechaConsulta" />
                                <button type="button" class="win-btn" style="height: 22px;" @onclick="CargarRegistroEnFechaAsync" disabled="@isLoadingFecha">
                                    @(isLoadingFecha ? "Buscando..." : "Cargar")
                                </button>
                                @if (mostrandoHistorico)
                                {
                                    <button type="button" class="win-btn" style="height: 22px;" @onclick="CargarRegistroVigenteActualAsync" disabled="@isLoadingFecha">
                                        Vigente actual
                                    </button>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(mensajeFecha))
                            {
                                <span class="text-danger fw-bold">@mensajeFecha</span>
                            }
                        </div>

                        <div class="row g-4">
                            <!-- Izquierda: Contenidos del Registro por secciones -->
                            <div class="col-md-8">
                                @if (!Registro.Contenidos.Any())
                                {
                                    <p class="text-muted fst-italic" style="font-size: 13px;">
                                        Este registro aún no posee secciones de contenido.
                                    </p>
                                }
                                else
                                {
                                    @foreach (var cont in Registro.Contenidos.OrderBy(c => c.NroContenido))
                                    {
                                        <section class="mb-3">
                                            <h5 style="font-family: Georgia, 'Times New Roman', serif; font-size: 16px; font-weight: bold; color: #2c2721; margin-bottom: 6px;">
                                                @cont.Titulo
                                            </h5>
                                            <p style="font-size: 13px; line-height: 1.65; color: #2e2e2e; white-space: pre-line; text-align: justify; margin-bottom: 0;">
                                                @cont.Contenido
                                            </p>
                                        </section>
                                    }
                                }
                            </div>

                            <!-- Derecha: Detalles de la Bestia y del Registro -->
                            <div class="col-md-4">
                                <div style="background-color: #e4e0d8; border: 1px solid #c9c3b6; border-radius: 6px; padding: 14px 12px; text-align: center;">
                                    @if (!string.IsNullOrWhiteSpace(Registro.MainPictureUrl))
                                    {
                                        var fallbackUrl = string.IsNullOrWhiteSpace(Registro.DefaultPictureUrl) ? Registro.MainPictureUrl : Registro.DefaultPictureUrl;
                                        <div class="mb-2">
                                            <img src="@Registro.MainPictureUrl"
                                                 alt="@(bestiaActual?.Nombre ?? "Bestia")"
                                                 onerror="this.onerror=null;this.src='@fallbackUrl';"
                                                 style="width: 100%; max-height: 240px; object-fit: cover; border-radius: 4px; border: 1px solid #bfb8a8;" />
                                        </div>
                                    }
                                    <div style="font-family: Georgia, 'Times New Roman', serif; font-size: 14px; font-weight: bold; color: #2b2620; margin-bottom: 6px;">
                                        Detalles de la bestia
                                    </div>
                                    <div style="font-size: 12px; color: #333; margin-bottom: 2px;">
                                        <strong>Nombre:</strong> @(bestiaActual?.Nombre ?? "-")
                                    </div>
                                    <div style="font-size: 12px; color: #333; margin-bottom: 12px;">
                                        <strong>Peligrosidad:</strong>
                                        <span class="badge bg-secondary ms-1" style="font-size: 10px;">@(bestiaActual?.Peligrosidad ?? "-")</span>
                                    </div>

                                    <div style="font-family: Georgia, 'Times New Roman', serif; font-size: 13px; font-weight: bold; color: #2b2620; margin-bottom: 6px; border-top: 1px solid #ccc5b8; padding-top: 10px;">
                                        Categorías
                                    </div>
                                    <div class="d-flex flex-wrap justify-content-center gap-1 mb-3">
                                        @if (bestiaActual?.CategoriasNombres != null && bestiaActual.CategoriasNombres.Any())
                                        {
                                            @foreach (var cat in bestiaActual.CategoriasNombres)
                                            {
                                                <span class="badge bg-light text-dark border" style="font-size: 11px;">▶ @cat</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-size: 11px;">Sin categorías</span>
                                        }
                                    </div>

                                    <div style="font-family: Georgia, 'Times New Roman', serif; font-size: 13px; font-weight: bold; color: #2b2620; margin-bottom: 4px; border-top: 1px solid #ccc5b8; padding-top: 10px;">
                                        Hábitat localizado
                                    </div>
                                    <div style="font-size: 12px; color: #333; margin-bottom: 12px;">
                                        @(string.IsNullOrWhiteSpace(bestiaActual?.HabitatNombre) ? "Sin hábitat asignado" : bestiaActual.HabitatNombre)
                                    </div>

                                    <div style="font-family: Georgia, 'Times New Roman', serif; font-size: 13px; font-weight: bold; color: #2b2620; margin-bottom: 6px; border-top: 1px solid #ccc5b8; padding-top: 10px;">
                                        Detalles de registro
                                    </div>
                                    <div style="font-size: 11px; color: #333; line-height: 1.55;">
                                        <div><strong>Nro. Registro:</strong> #@Registro.NroRegistro</div>
                                        <div>
                                            <strong>Estado:</strong>
                                            <span class="badge @(Registro.Estado == "aprobado" ? "bg-success" : "bg-warning text-dark")" style="font-size: 10px;">
                                                @Registro.Estado
                                            </span>
                                        </div>
                                        <div><strong>Publicado por:</strong> @(Registro.CorreoPublicador ?? "N/A")</div>
                                        <div><strong>Aprobado por:</strong> @(Registro.NombreInvestigadorAprobador ?? "Pendiente")</div>
                                        @if (Registro.FechaAprobacion.HasValue)
                                        {
                                            <div><strong>Aprobación:</strong> @Registro.FechaAprobacion.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Abajo: Evidencias de la Bestia -->
                        <div class="mt-4 pt-3" style="border-top: 1px solid #bdb6a7;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div style="font-family: Georgia, 'Times New Roman', serif; font-size: 15px; font-weight: bold; color: #2b2620;">
                                    Evidencias registradas (@evidenciasBestia.Count)
                                </div>
                                @if (Auth.IsAuthenticated)
                                {
                                    <button type="button" class="win-btn" style="height: 22px; font-size: 11px;" @onclick="AbrirFormEvidenciaAsync">
                                        + Proponer nueva evidencia
                                    </button>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(evidenciaError))
                            {
                                <div class="win-error-msg mb-2" style="font-size: 11px;">
                                    <span class="oi oi-warning me-1"></span> @evidenciaError
                                </div>
                            }

                            @if (mostrandoFormEvidencia && Auth.IsAuthenticated)
                            {
                                <div class="p-2 border rounded mb-3" style="background-color: #efece3; font-size: 11px;">
                                    <div class="fw-bold mb-2">Proponer nueva evidencia</div>
                                    <div class="row g-2 mb-2">
                                        <div class="col-md-5">
                                            <label class="win-label">Tipo de evidencia:</label>
                                            <select class="win-textbox w-100" @bind="nuevaEvidenciaTipoId" disabled="@isProcesandoEvidencia">
                                                <option value="">-- Seleccione --</option>
                                                @foreach (var t in tiposEvidenciaDisponibles)
                                                {
                                                    <option value="@t.Id">@t.Descripcion (@t.ResourceType)</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="win-label">Fecha obtención:</label>
                                            <input type="datetime-local" class="win-textbox w-100" @bind="nuevaEvidenciaFecha" disabled="@isProcesandoEvidencia" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="win-label">Archivo:</label>
                                            <InputFile OnChange="OnEvidenciaFileSelected" disabled="@isProcesandoEvidencia" style="font-size: 11px;" />
                                            @if (!string.IsNullOrEmpty(nuevaEvidenciaFileName))
                                            {
                                                <div class="text-success" style="font-size: 10px;">@nuevaEvidenciaFileName</div>
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-end gap-2">
                                        <button type="button" class="win-btn" @onclick="ProponerEvidenciaAsync" disabled="@isProcesandoEvidencia">
                                            @(isProcesandoEvidencia ? "Subiendo y enviando..." : "Enviar evidencia")
                                        </button>
                                        <button type="button" class="win-btn" @onclick="@(() => mostrandoFormEvidencia = false)" disabled="@isProcesandoEvidencia">
                                            Cancelar
                                        </button>
                                    </div>
                                </div>
                            }

                            @if (isLoadingEvidencias)
                            {
                                <div class="text-muted" style="font-size: 12px;">Cargando evidencias...</div>
                            }
                            else if (!evidenciasBestia.Any())
                            {
                                <div class="text-muted fst-italic" style="font-size: 12px;">
                                    No hay evidencias registradas para esta bestia.
                                </div>
                            }
                            else
                            {
                                <div class="row g-2">
                                    @foreach (var ev in evidenciasBestia)
                                    {
                                        var rType = (ev.TipoEvidenciaResourceType ?? string.Empty).Trim().ToLowerInvariant();
                                        <div class="col-md-6">
                                            <div class="p-2 border rounded" style="background-color: #ffffff; font-size: 11px;">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <strong>Evidencia #@ev.NroEvidencia — @(ev.TipoEvidenciaDescripcion ?? "Archivo")</strong>
                                                    <span class="badge @(ev.Estado == "aprobado" ? "bg-success" : "bg-warning text-dark")" style="font-size: 10px;">
                                                        @ev.Estado
                                                    </span>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(ev.FileUrl))
                                                {
                                                    <div class="my-1">
                                                        @if (rType == "image")
                                                        {
                                                            <div style="width: 100%; max-height: 220px; overflow: auto; border-radius: 4px; border: 1px solid #c9b489; background-color: #faf7f0;">
                                                                <a href="@ev.FileUrl" target="_blank" title="Abrir imagen en nueva pestaña">
                                                                    <img src="@ev.FileUrl" alt="Evidencia #@ev.NroEvidencia" style="display: block; max-width: none;" />
                                                                </a>
                                                            </div>
                                                        }
                                                        else if (rType == "video")
                                                        {
                                                            <video controls src="@ev.FileUrl" style="width: 100%; max-height: 180px; border-radius: 4px;"></video>
                                                        }
                                                        else if (rType == "audio")
                                                        {
                                                            <audio controls src="@ev.FileUrl" style="width: 100%;"></audio>
                                                        }
                                                        else
                                                        {
                                                            <a href="@ev.FileUrl" target="_blank" class="win-btn d-inline-block text-decoration-none" style="height: 20px; font-size: 10px; padding: 1px 6px;">
                                                                Descargar / Ver archivo
                                                            </a>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-muted" style="font-family: monospace;">
                                                        [@(ev.TipoEvidenciaResourceType ?? "-")] @ev.FileId
                                                    </div>
                                                }
                                                <div class="d-flex justify-content-between align-items-center mt-1">
                                                    <span class="text-muted">Obtenida: @ev.FechaObtencion.ToString("dd/MM/yyyy HH:mm")</span>
                                                    @if (Auth.EsInvestigador)
                                                    {
                                                        <div class="d-flex gap-1">
                                                            @if (ev.Estado != null && ev.Estado.Equals("pendiente", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <button type="button" class="win-btn text-success" style="height: 19px; font-size: 10px; padding: 0 5px;"
                                                                        @onclick="() => AprobarEvidenciaAsync(ev)" disabled="@isProcesandoEvidencia">
                                                                    Aprobar
                                                                </button>
                                                            }
                                                            <button type="button" class="win-btn text-danger" style="height: 19px; font-size: 10px; padding: 0 5px;"
                                                                    @onclick="() => EliminarEvidenciaAsync(ev)" disabled="@isProcesandoEvidencia">
                                                                Eliminar
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Abajo: Comentarios de la Bestia (solo si el registro está aprobado) -->
                        @if (Registro.Estado != null && Registro.Estado.Equals("aprobado", StringComparison.OrdinalIgnoreCase))
                        {
                            <div id="comentarios" class="mt-4 pt-3" style="border-top: 1px solid #bdb6a7;">
                                <div style="font-family: Georgia, 'Times New Roman', serif; font-size: 15px; font-weight: bold; color: #2b2620; margin-bottom: 8px;">
                                    Comentarios (@comentariosBestia.Count)
                                </div>

                                @if (!string.IsNullOrEmpty(comentarioError))
                                {
                                    <div class="win-error-msg mb-2" style="font-size: 11px;">
                                        <span class="oi oi-warning me-1"></span> @comentarioError
                                    </div>
                                }

                                @if (isLoadingComentarios)
                                {
                                    <div class="text-muted" style="font-size: 12px;">Cargando comentarios...</div>
                                }
                                else if (!comentariosBestia.Any())
                                {
                                    <div class="text-muted fst-italic mb-2" style="font-size: 12px;">
                                        No hay comentarios para esta bestia.
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-column gap-2 mb-3">
                                        @foreach (var com in comentariosBestia)
                                        {
                                            <div class="p-2 border rounded" style="background-color: #ffffff; font-size: 12px;">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <div>
                                                        <strong>@(string.IsNullOrWhiteSpace(com.CorreoUsuario) ? "Usuario" : com.CorreoUsuario)</strong>
                                                        <span class="text-muted ms-1">- Publicado el @com.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")</span>
                                                    </div>
                                                    @if (Auth.EsInvestigador)
                                                    {
                                                        <button type="button" class="win-btn text-danger" style="height: 20px; font-size: 10px; padding: 0 6px;"
                                                                @onclick="() => SolicitarEliminarComentario(com)" disabled="@isProcesandoComentario">
                                                            Eliminar
                                                        </button>
                                                    }
                                                </div>
                                                <div style="white-space: pre-line; color: #2e2e2e;">
                                                    @com.Contenido
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @if (Auth.IsAuthenticated)
                                {
                                    <div class="p-2 border rounded" style="background-color: #efece3;">
                                        <div style="font-size: 11px; font-weight: bold; margin-bottom: 6px; color: #2b2620;">
                                            Agregar comentario
                                        </div>
                                        <div class="mb-2">
                                            <textarea class="win-textbox w-100" rows="2" style="height: auto; padding: 4px;"
                                                      placeholder="Escriba su comentario..." @bind="nuevoComentarioTexto" disabled="@isProcesandoComentario"></textarea>
                                        </div>
                                        <div class="d-flex justify-content-end">
                                            <button type="button" class="win-btn" @onclick="AgregarComentarioAsync" disabled="@isProcesandoComentario">
                                                @(isProcesandoComentario ? "Publicando..." : "Publicar comentario")
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Barra inferior de la vista Enciclopedia -->
                    <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                        @if (Auth.IsAuthenticated)
                        {
                            <button type="button" class="win-btn me-auto" @onclick="IniciarPropuestaNuevoRegistro">
                                + Proponer nuevo registro
                            </button>
                        }
                        @if (Auth.EsInvestigador)
                        {
                            @if (Registro.Estado != null && Registro.Estado.Equals("pendiente", StringComparison.OrdinalIgnoreCase))
                            {
                                <button type="button" class="win-btn text-success" @onclick="AprobarRegistroActualAsync" disabled="@isSaving">
                                    ✔ Aprobar
                                </button>
                                <button type="button" class="win-btn text-danger" @onclick="() => showConfirmEliminarRegistro = true" disabled="@isSaving">
                                    ✕ Eliminar (Pendiente)
                                </button>
                            }
                            else
                            {
                                <button type="button" class="win-btn text-warning" @onclick="DejarPendienteRegistroActualAsync" disabled="@isSaving">
                                    ↩ Dejar Pendiente
                                </button>
                            }
                        }
                        <button type="button" class="win-btn" @onclick="Cancel">
                            Cerrar
                        </button>
                    </div>
                }
                else
                {
                    <!-- MODO ALTA / EDICIÓN (MAESTRO / DETALLE) -->
                    @if (Mode == FormMode.Update && !esPropuestaNueva)
                    {
                        <div class="alert alert-warning py-1 mb-2" style="font-size: 11px;">
                            El contenido y la imagen de un registro ya subido no se pueden editar. Solo podés cambiar su estado (aprobar o dejar pendiente).
                        </div>
                    }
                    else if (Auth.EsLector && Mode == FormMode.Add)
                    {
                        <div class="alert alert-info py-1 mb-2" style="font-size: 11px;">
                            Tu registro se enviará en estado <strong>pendiente</strong> para revisión de un investigador.
                        </div>
                    }

                    <!-- DATOS MAESTRO (Registro) -->
                    <fieldset style="border: 1px solid #c0c0c0; padding: 10px 14px; margin-bottom: 12px; background: #fafafa;">
                        <legend style="font-size: 11px; font-weight: bold; width: auto; padding: 0 4px; margin-bottom: 0;">
                            Datos Principales (Registro)
                        </legend>

                        <div class="row align-items-center mb-2">
                            <div class="col-3">
                                <label class="win-label">Bestia:</label>
                            </div>
                            <div class="col-9">
                                @if (Mode == FormMode.Update)
                                {
                                    var nombreBestia = Bestias.FirstOrDefault(b => b.Id == Registro.IdBestia)?.Nombre ?? Registro.IdBestia.ToString();
                                    <input type="text" class="win-textbox w-100" value="@nombreBestia" readonly />
                                }
                                else
                                {
                                    <select class="win-textbox w-100" @bind="Registro.IdBestia" disabled="@(isSaving || !PuedeEditar)">
                                        <option value="@Guid.Empty">-- Seleccione una Bestia --</option>
                                        @foreach (var b in Bestias)
                                        {
                                            <option value="@b.Id">@b.Nombre (@b.Peligrosidad)</option>
                                        }
                                    </select>
                                }
                            </div>
                        </div>

                        @if (Mode == FormMode.Update)
                        {
                            <div class="row align-items-center mb-2">
                                <div class="col-3">
                                    <label class="win-label">Nro. Registro:</label>
                                </div>
                                <div class="col-9">
                                    <input type="text" class="win-textbox" style="width: 100px;" value="@Registro.NroRegistro" readonly />
                                </div>
                            </div>
                        }

                        <div class="row align-items-center mb-2">
                            <div class="col-3">
                                <label class="win-label">Estado:</label>
                            </div>
                            <div class="col-9">
                                <select class="win-textbox" style="width: 140px;" @bind="Registro.Estado" disabled="@(isSaving || !Auth.EsInvestigador)">
                                    <option value="pendiente">pendiente</option>
                                    <option value="aprobado">aprobado</option>
                                </select>
                            </div>
                        </div>

                        <div class="row align-items-center mb-2">
                            <div class="col-3">
                                <label class="win-label">Imagen:</label>
                            </div>
                            <div class="col-9">
                                <InputFile OnChange="OnMainPicSelected" accept="image/*" disabled="@(isSaving || !PuedeEditarContenido)" style="font-size: 11px;" />
                                @if (!string.IsNullOrEmpty(selectedMainPicName))
                                {
                                    <div class="text-success" style="font-size: 10px; margin-top: 2px;">
                                        Seleccionada: @selectedMainPicName
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(Registro.MainPicture))
                                {
                                    <div class="text-muted" style="font-size: 10px; margin-top: 2px;">
                                        Imagen actual conservada (sube otra para reemplazar).
                                    </div>
                                }
                            </div>
                        </div>

                        @if (Mode == FormMode.Update)
                        {
                            <div class="row align-items-center mb-1">
                                <div class="col-3">
                                    <label class="win-label">Publicador:</label>
                                </div>
                                <div class="col-9">
                                    <span class="text-muted" style="font-size: 11px;">@(Registro.CorreoPublicador ?? "N/A")</span>
                                </div>
                            </div>

                            <div class="row align-items-center mb-1">
                                <div class="col-3">
                                    <label class="win-label">Aprobador:</label>
                                </div>
                                <div class="col-9">
                                    <span class="text-muted" style="font-size: 11px;">@(Registro.NombreInvestigadorAprobador ?? "Pendiente de aprobación")</span>
                                </div>
                            </div>

                            @if (Registro.FechaAprobacion.HasValue)
                            {
                                <div class="row align-items-center mb-1">
                                    <div class="col-3">
                                        <label class="win-label">Aprobado el:</label>
                                    </div>
                                    <div class="col-9">
                                        <span class="text-muted" style="font-size: 11px;">@Registro.FechaAprobacion.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                </div>
                            }
                        }
                    </fieldset>

                    <!-- DATOS DETALLE (Contenidos del Registro) -->
                    <fieldset style="border: 1px solid #c0c0c0; padding: 10px 14px; background: #fafafa;">
                        <legend style="font-size: 11px; font-weight: bold; width: auto; padding: 0 4px; margin-bottom: 0;">
                            Detalle de Contenidos (@Registro.Contenidos.Count)
                        </legend>

                        <!-- Grilla de Contenidos -->
                        <div class="win-grid-container mb-2" style="height: 140px;">
                            <table class="win-grid">
                                <thead>
                                    <tr>
                                        <th style="width: 35px;">#</th>
                                        <th style="width: 160px;">Título</th>
                                        <th>Contenido</th>
                                        <th style="width: 50px; text-align: center;">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Registro.Contenidos.Any())
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center py-2 text-muted">
                                                No hay secciones de contenido agregadas aún.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @for (int i = 0; i < Registro.Contenidos.Count; i++)
                                        {
                                            var idx = i;
                                            var cont = Registro.Contenidos[idx];
                                            <tr>
                                                <td style="font-size: 10px; font-weight: bold;">@cont.NroContenido</td>
                                                <td><strong>@cont.Titulo</strong></td>
                                                <td style="font-size: 11px;">@cont.Contenido</td>
                                                <td style="text-align: center;">
                                                    @if (PuedeEditarContenido)
                                                    {
                                                        <button type="button" class="btn btn-outline-danger btn-sm p-0 px-1" 
                                                                style="font-size: 10px;" 
                                                                @onclick="() => EliminarContenido(idx)" 
                                                                disabled="@isSaving">
                                                            ✕
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (PuedeEditarContenido)
                        {
                            <!-- Formulario para agregar un nuevo contenido detalle -->
                            <div style="background: #ffffff; border: 1px dashed #a0a0a0; padding: 8px 10px; border-radius: 2px;">
                                <span class="fw-bold d-block mb-1" style="font-size: 11px;">+ Agregar Nueva Sección al Registro:</span>
                                <div class="row g-2 align-items-center mb-1">
                                    <div class="col-4">
                                        <input type="text" class="win-textbox w-100" placeholder="Título de la sección..." 
                                               @bind="nuevoTitulo" disabled="@isSaving" maxlength="100" />
                                    </div>
                                    <div class="col-6">
                                        <input type="text" class="win-textbox w-100" placeholder="Contenido o descripción..." 
                                               @bind="nuevoContenido" disabled="@isSaving" />
                                    </div>
                                    <div class="col-2 text-end">
                                        <button type="button" class="win-btn w-100" style="height: 24px; font-size: 11px;" 
                                                @onclick="AgregarContenido" disabled="@isSaving">
                                            Agregar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </fieldset>

                    <!-- Botones Aceptar / Cancelar -->
                    <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                        @if (Mode == FormMode.Update)
                        {
                            <button type="button" class="win-btn me-auto" @onclick="() => isEditMode = false" disabled="@isSaving">
                                ← Vista Enciclopedia
                            </button>
                        }
                        @if (PuedeEditar)
                        {
                            <button type="button" class="win-btn" @onclick="Save" disabled="@isSaving">
                                @(isSaving ? "Guardando..." : (Auth.EsInvestigador ? "Aceptar" : "Proponer"))
                            </button>
                        }
                        <button type="button" class="win-btn" @onclick="Cancel" disabled="@isSaving">
                            @(PuedeEditar ? "Cancelar" : "Cerrar")
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <ConfirmModal IsOpen="@showConfirmEliminarComentario"
                  Title="Confirmar eliminación"
                  Message="¿Estás seguro que deseas eliminar este comentario?"
                  OnConfirm="ConfirmarEliminarComentarioAsync"
                  OnCancel="@(() => { showConfirmEliminarComentario = false; comentarioAEliminar = null; })" />

    <ConfirmModal IsOpen="@showConfirmEliminarRegistro"
                  Title="Eliminar registro pendiente"
                  Message="@($"¿Estás seguro que deseas eliminar físicamente el Registro #{Registro.NroRegistro}? Esta acción no se puede deshacer.")"
                  OnConfirm="ConfirmarEliminarRegistroAsync"
                  OnCancel="@(() => showConfirmEliminarRegistro = false)" />
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public FormMode Mode { get; set; } = FormMode.Add;
    [Parameter] public RegistroDTO Registro { get; set; } = new RegistroDTO();
    [Parameter] public List<BestiaDTO> Bestias { get; set; } = new List<BestiaDTO>();

    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool isSaving = false;
    private bool isEditMode = false;
    private bool esPropuestaNueva = false;
    private bool wasOpen = false;
    private Guid? lastLoadedBestiaId;
    private int lastLoadedNroRegistro;
    private string? errorMessage;
    private bool showConfirmEliminarRegistro = false;
    private bool PuedeEditar => Auth.EsInvestigador || (Auth.EsLector && (Mode == FormMode.Add || esPropuestaNueva));
    private bool PuedeEditarContenido => (Mode == FormMode.Add || esPropuestaNueva) && PuedeEditar;

    private async Task AprobarRegistroActualAsync()
    {
        if (!Auth.EsInvestigador || Auth.CurrentUser == null) return;
        try
        {
            isSaving = true;
            errorMessage = null;
            await RegistroApiClient.AprobarAsync(Registro.IdBestia, Registro.NroRegistro, Auth.CurrentUser.Id);
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al aprobar registro: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DejarPendienteRegistroActualAsync()
    {
        if (!Auth.EsInvestigador) return;
        try
        {
            isSaving = true;
            errorMessage = null;
            Registro.Estado = "pendiente";
            Registro.FechaAprobacion = null;
            Registro.FechaBaja = null;
            Registro.IdInvestigadorAprobador = null;
            await RegistroApiClient.UpdateAsync(Registro);
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al pasar registro a pendiente: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ConfirmarEliminarRegistroAsync()
    {
        showConfirmEliminarRegistro = false;
        if (!Auth.EsInvestigador) return;
        try
        {
            isSaving = true;
            errorMessage = null;
            await RegistroApiClient.DeleteAsync(Registro.IdBestia, Registro.NroRegistro);
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar registro: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private DateTime? fechaConsulta = DateTime.Now;
    private bool isLoadingFecha = false;
    private bool mostrandoHistorico = false;
    private string? mensajeFecha;

    private BestiaDTO? bestiaActual;
    private List<EvidenciaDTO> evidenciasBestia = new();
    private bool isLoadingEvidencias = false;

    private List<ComentarioDTO> comentariosBestia = new();
    private bool isLoadingComentarios = false;
    private bool isProcesandoComentario = false;
    private string? comentarioError;
    private string nuevoComentarioTexto = string.Empty;
    private ComentarioDTO? comentarioAEliminar;
    private bool showConfirmEliminarComentario = false;

    private string nuevoTitulo = string.Empty;
    private string nuevoContenido = string.Empty;
    private IBrowserFile? selectedMainPicFile;
    private string? selectedMainPicName;

    private void OnMainPicSelected(InputFileChangeEventArgs e)
    {
        selectedMainPicFile = e.File;
        selectedMainPicName = e.File?.Name;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen)
        {
            wasOpen = false;
            selectedMainPicFile = null;
            selectedMainPicName = null;
            return;
        }

        if (Registro == null)
            Registro = new RegistroDTO();

        if (!Auth.EsInvestigador && (Mode == FormMode.Add || esPropuestaNueva))
            Registro.Estado = "pendiente";
        else if (string.IsNullOrEmpty(Registro.Estado))
            Registro.Estado = "pendiente";

        bool recienAbierto = !wasOpen || lastLoadedBestiaId != Registro.IdBestia || lastLoadedNroRegistro != Registro.NroRegistro;
        wasOpen = true;

        if (recienAbierto)
        {
            errorMessage = null;
            comentarioError = null;
            mensajeFecha = null;
            mostrandoHistorico = false;
            fechaConsulta = DateTime.Now;
            esPropuestaNueva = Mode == FormMode.Add;
            nuevoTitulo = string.Empty;
            nuevoContenido = string.Empty;
            nuevoComentarioTexto = string.Empty;
            showConfirmEliminarComentario = false;
            comentarioAEliminar = null;
            isEditMode = Mode == FormMode.Add;
            lastLoadedBestiaId = Registro.IdBestia;
            lastLoadedNroRegistro = Registro.NroRegistro;
            bestiaActual = Bestias.FirstOrDefault(b => b.Id == Registro.IdBestia);

            if (Mode == FormMode.Update && Registro.IdBestia != Guid.Empty)
            {
                await CargarEvidenciasBestiaAsync(Registro.IdBestia);
                if (Registro.Estado != null && Registro.Estado.Equals("aprobado", StringComparison.OrdinalIgnoreCase))
                {
                    await CargarComentariosBestiaAsync(Registro.IdBestia);
                }
                else
                {
                    comentariosBestia = new List<ComentarioDTO>();
                }
            }
            else
            {
                evidenciasBestia = new List<EvidenciaDTO>();
                comentariosBestia = new List<ComentarioDTO>();
            }
        }
    }

    private async Task CargarComentariosBestiaAsync(Guid idBestia)
    {
        try
        {
            isLoadingComentarios = true;
            var res = await ComentarioApiClient.GetByBestiaAsync(idBestia);
            comentariosBestia = res?.ToList() ?? new List<ComentarioDTO>();
        }
        catch (Exception ex)
        {
            comentarioError = $"Error al cargar comentarios: {ex.Message}";
            comentariosBestia = new List<ComentarioDTO>();
        }
        finally
        {
            isLoadingComentarios = false;
        }
    }

    private async Task AgregarComentarioAsync()
    {
        if (!Auth.IsAuthenticated) return;

        if (string.IsNullOrWhiteSpace(nuevoComentarioTexto))
        {
            comentarioError = "El contenido del comentario es requerido.";
            return;
        }

        try
        {
            isProcesandoComentario = true;
            comentarioError = null;

            var dto = new ComentarioDTO
            {
                IdBestia = Registro.IdBestia,
                IdUsuario = Auth.CurrentUser?.Id ?? Guid.Empty,
                Contenido = nuevoComentarioTexto.Trim()
            };

            await ComentarioApiClient.AddAsync(dto);
            nuevoComentarioTexto = string.Empty;
            await CargarComentariosBestiaAsync(Registro.IdBestia);
        }
        catch (Exception ex)
        {
            comentarioError = $"Error al publicar comentario: {ex.Message}";
        }
        finally
        {
            isProcesandoComentario = false;
        }
    }

    private void SolicitarEliminarComentario(ComentarioDTO comentario)
    {
        if (!Auth.EsInvestigador) return;
        comentarioAEliminar = comentario;
        showConfirmEliminarComentario = true;
    }

    private async Task ConfirmarEliminarComentarioAsync()
    {
        if (comentarioAEliminar == null || !Auth.EsInvestigador)
        {
            showConfirmEliminarComentario = false;
            return;
        }

        try
        {
            isProcesandoComentario = true;
            comentarioError = null;
            await ComentarioApiClient.DeleteAsync(comentarioAEliminar.Id);
            showConfirmEliminarComentario = false;
            comentarioAEliminar = null;
            await CargarComentariosBestiaAsync(Registro.IdBestia);
        }
        catch (Exception ex)
        {
            comentarioError = $"Error al eliminar comentario: {ex.Message}";
            showConfirmEliminarComentario = false;
        }
        finally
        {
            isProcesandoComentario = false;
        }
    }

    private async Task CargarEvidenciasBestiaAsync(Guid idBestia)
    {
        try
        {
            isLoadingEvidencias = true;
            var res = await EvidenciaApiClient.GetByBestiaAsync(idBestia);
            var lista = res?.ToList() ?? new List<EvidenciaDTO>();
            if (!Auth.EsInvestigador)
            {
                lista = lista.Where(e => e.Estado != null && e.Estado.Equals("aprobado", StringComparison.OrdinalIgnoreCase)).ToList();
            }
            evidenciasBestia = lista.OrderBy(e => e.NroEvidencia).ToList();
        }
        catch
        {
            evidenciasBestia = new List<EvidenciaDTO>();
        }
        finally
        {
            isLoadingEvidencias = false;
        }
    }

    private void AgregarContenido()
    {
        if (string.IsNullOrWhiteSpace(nuevoTitulo))
        {
            errorMessage = "El título de la sección de contenido es requerido.";
            return;
        }

        if (string.IsNullOrWhiteSpace(nuevoContenido))
        {
            errorMessage = "El texto de contenido es requerido.";
            return;
        }

        errorMessage = null;

        var proximoNro = Registro.Contenidos.Any() 
            ? Registro.Contenidos.Max(c => c.NroContenido) + 1 
            : 1;

        Registro.Contenidos.Add(new ContenidoRegistroDTO
        {
            IdBestia = Registro.IdBestia,
            NroRegistro = Registro.NroRegistro,
            NroContenido = proximoNro,
            Titulo = nuevoTitulo.Trim(),
            Contenido = nuevoContenido.Trim()
        });

        nuevoTitulo = string.Empty;
        nuevoContenido = string.Empty;
    }

    private void EliminarContenido(int index)
    {
        if (index >= 0 && index < Registro.Contenidos.Count)
        {
            Registro.Contenidos.RemoveAt(index);
            // Re-numerar correlativo 1..N
            for (int i = 0; i < Registro.Contenidos.Count; i++)
            {
                Registro.Contenidos[i].NroContenido = i + 1;
            }
        }
    }

    private bool ValidateInput()
    {
        if (Registro.IdBestia == Guid.Empty)
        {
            errorMessage = "Debe seleccionar una Bestia para el registro.";
            return false;
        }

        if (!Registro.Contenidos.Any())
        {
            errorMessage = "Debe agregar al menos una sección de contenido al registro.";
            return false;
        }

        errorMessage = null;
        return true;
    }

    private async Task Save()
    {
        if (!ValidateInput()) return;

        string? uploadedPublicId = null;
        try
        {
            isSaving = true;
            errorMessage = null;

            if (selectedMainPicFile != null)
            {
                const long maxFileSize = 25 * 1024 * 1024;
                await using var stream = selectedMainPicFile.OpenReadStream(maxFileSize);
                var contentType = string.IsNullOrWhiteSpace(selectedMainPicFile.ContentType)
                    ? "image/jpeg"
                    : selectedMainPicFile.ContentType;
                uploadedPublicId = await CloudinaryApiClient.UploadImageAsync(stream, selectedMainPicFile.Name, contentType);
                if (!string.IsNullOrWhiteSpace(uploadedPublicId))
                {
                    Registro.MainPicture = uploadedPublicId;
                }
            }

            // Asegurar que cada contenido tenga asignada la FK compuesta
            foreach (var c in Registro.Contenidos)
            {
                c.IdBestia = Registro.IdBestia;
                c.NroRegistro = Registro.NroRegistro;
            }

            if (Mode == FormMode.Add || esPropuestaNueva)
            {
                if (Auth.EsInvestigador)
                {
                    Registro.Estado = "aprobado";
                    Registro.FechaAprobacion = DateTime.Now;
                    Registro.IdInvestigadorAprobador = Auth.CurrentUser?.Id;
                }
                else
                {
                    Registro.Estado = "pendiente";
                    Registro.FechaAprobacion = null;
                    Registro.IdInvestigadorAprobador = null;
                }

                // Asignar publicador desde sesión si es nuevo
                if (Registro.IdUsuarioPublicador == Guid.Empty)
                {
                    Registro.IdUsuarioPublicador = Auth.CurrentUser?.Id ?? Guid.Parse("99999999-9999-9999-9999-999999999999");
                }

                await RegistroApiClient.AddAsync(Registro);
            }
            else
            {
                await RegistroApiClient.UpdateAsync(Registro);
            }

            selectedMainPicFile = null;
            selectedMainPicName = null;
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            if (!string.IsNullOrWhiteSpace(uploadedPublicId))
            {
                try { await CloudinaryApiClient.DeleteImageAsync(uploadedPublicId); } catch { }
            }
            errorMessage = $"Error al guardar registro: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task CargarRegistroEnFechaAsync()
    {
        if (Registro.IdBestia == Guid.Empty) return;

        try
        {
            isLoadingFecha = true;
            mensajeFecha = null;
            var encontrado = await RegistroApiClient.GetVigenteAsync(Registro.IdBestia, fechaConsulta ?? DateTime.Now);
            if (encontrado == null)
            {
                mensajeFecha = "No existen registros aprobados para esta bestia en esa fecha.";
                return;
            }

            Registro = encontrado;
            lastLoadedNroRegistro = encontrado.NroRegistro;
            mostrandoHistorico = true;
            await CargarComentariosBestiaAsync(Registro.IdBestia);
        }
        catch (Exception ex)
        {
            mensajeFecha = $"Error al consultar fecha: {ex.Message}";
        }
        finally
        {
            isLoadingFecha = false;
        }
    }

    private async Task CargarRegistroVigenteActualAsync()
    {
        fechaConsulta = DateTime.Now;
        await CargarRegistroEnFechaAsync();
        mostrandoHistorico = false;
    }

    private void IniciarPropuestaNuevoRegistro()
    {
        if (!Auth.IsAuthenticated) return;

        var contenidosCopia = Registro.Contenidos
            .OrderBy(c => c.NroContenido)
            .Select(c => new ContenidoRegistroDTO
            {
                IdBestia = Registro.IdBestia,
                NroRegistro = 0,
                NroContenido = c.NroContenido,
                Titulo = c.Titulo,
                Contenido = c.Contenido
            })
            .ToList();

        Registro = new RegistroDTO
        {
            IdBestia = Registro.IdBestia,
            NroRegistro = 0,
            Estado = Auth.EsInvestigador ? "aprobado" : "pendiente",
            IdUsuarioPublicador = Auth.CurrentUser?.Id ?? Guid.Empty,
            Contenidos = contenidosCopia
        };

        esPropuestaNueva = true;
        isEditMode = true;
        errorMessage = null;
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }

    private bool mostrandoFormEvidencia = false;
    private bool isProcesandoEvidencia = false;
    private string? evidenciaError;
    private List<TipoEvidenciaDTO> tiposEvidenciaDisponibles = new();
    private string nuevaEvidenciaTipoId = string.Empty;
    private DateTime nuevaEvidenciaFecha = DateTime.Now;
    private IBrowserFile? nuevaEvidenciaFile;
    private string? nuevaEvidenciaFileName;

    private void OnEvidenciaFileSelected(InputFileChangeEventArgs e)
    {
        nuevaEvidenciaFile = e.File;
        nuevaEvidenciaFileName = e.File?.Name;
    }

    private async Task AbrirFormEvidenciaAsync()
    {
        evidenciaError = null;
        nuevaEvidenciaFile = null;
        nuevaEvidenciaFileName = null;
        nuevaEvidenciaFecha = DateTime.Now;
        if (!tiposEvidenciaDisponibles.Any())
        {
            try
            {
                tiposEvidenciaDisponibles = (await TipoEvidenciaApiClient.GetAllAsync()).ToList();
            }
            catch
            {
                tiposEvidenciaDisponibles = new();
            }
        }
        mostrandoFormEvidencia = !mostrandoFormEvidencia;
    }

    private async Task ProponerEvidenciaAsync()
    {
        if (!Auth.IsAuthenticated) return;

        if (!Guid.TryParse(nuevaEvidenciaTipoId, out var idTipo))
        {
            evidenciaError = "Debe seleccionar un tipo de evidencia.";
            return;
        }
        if (nuevaEvidenciaFile == null)
        {
            evidenciaError = "Debe seleccionar un archivo para la evidencia.";
            return;
        }

        string? uploadedPublicId = null;
        try
        {
            isProcesandoEvidencia = true;
            evidenciaError = null;

            const long maxEvidenceSize = 50 * 1024 * 1024;
            await using var stream = nuevaEvidenciaFile.OpenReadStream(maxEvidenceSize);
            var contentType = string.IsNullOrWhiteSpace(nuevaEvidenciaFile.ContentType)
                ? "application/octet-stream"
                : nuevaEvidenciaFile.ContentType;
            uploadedPublicId = await CloudinaryApiClient.UploadImageAsync(stream, nuevaEvidenciaFile.Name, contentType);
            if (string.IsNullOrWhiteSpace(uploadedPublicId))
            {
                throw new Exception("Cloudinary no devolvió un public_id válido.");
            }

            await EvidenciaApiClient.AddAsync(new EvidenciaDTO
            {
                IdBestia = Registro.IdBestia,
                IdTipoEvidencia = idTipo,
                FechaObtencion = nuevaEvidenciaFecha,
                FileId = uploadedPublicId,
                Estado = Auth.EsInvestigador ? "aprobado" : "pendiente"
            });

            nuevaEvidenciaFile = null;
            nuevaEvidenciaFileName = null;
            mostrandoFormEvidencia = false;
            await CargarEvidenciasBestiaAsync(Registro.IdBestia);
        }
        catch (Exception ex)
        {
            if (!string.IsNullOrWhiteSpace(uploadedPublicId))
            {
                try { await CloudinaryApiClient.DeleteImageAsync(uploadedPublicId); } catch { }
            }
            evidenciaError = $"Error al proponer evidencia: {ex.Message}";
        }
        finally
        {
            isProcesandoEvidencia = false;
        }
    }

    private async Task AprobarEvidenciaAsync(EvidenciaDTO ev)
    {
        if (!Auth.EsInvestigador) return;
        try
        {
            isProcesandoEvidencia = true;
            evidenciaError = null;
            await EvidenciaApiClient.AprobarAsync(ev.IdBestia, ev.NroEvidencia);
            await CargarEvidenciasBestiaAsync(Registro.IdBestia);
        }
        catch (Exception ex)
        {
            evidenciaError = $"Error al aprobar evidencia: {ex.Message}";
        }
        finally
        {
            isProcesandoEvidencia = false;
        }
    }

    private async Task EliminarEvidenciaAsync(EvidenciaDTO ev)
    {
        if (!Auth.EsInvestigador) return;
        try
        {
            isProcesandoEvidencia = true;
            evidenciaError = null;
            await EvidenciaApiClient.DeleteAsync(ev.IdBestia, ev.NroEvidencia);
            await CargarEvidenciasBestiaAsync(Registro.IdBestia);
        }
        catch (Exception ex)
        {
            evidenciaError = $"Error al eliminar evidencia: {ex.Message}";
        }
        finally
        {
            isProcesandoEvidencia = false;
        }
    }
}

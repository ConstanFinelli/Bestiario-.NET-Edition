    // --- Eliminación genérica ---
    private void SolicitarEliminar(string tipo, Guid id, string label)
    {
        deleteTipo = tipo;
        deleteId = id;
        deleteTargetLabel = label;
        isConfirmDeleteOpen = true;
    }

    private async Task ConfirmarEliminarAsync()
    {
        isConfirmDeleteOpen = false;
        await EjecutarAccionAsync(async () =>
        {
            switch (deleteTipo)
            {
                case "categoria": await CategoriaApiClient.DeleteAsync(deleteId); break;
                case "habitat": await HabitatApiClient.DeleteAsync(deleteId); break;
                case "usuario": await UsuarioApiClient.DeleteAsync(deleteId); break;
                case "tipoEvidencia": await TipoEvidenciaApiClient.DeleteAsync(deleteId); break;
            }
        }, $"'{deleteTargetLabel}' eliminado correctamente.");
    }

    private async Task EjecutarAccionAsync(Func<Task> accion, string mensajeExito)
    {
        try
        {
            isLoading = true;
            feedbackMessage = null;
            await accion();
            isFeedbackError = false;
            feedbackMessage = mensajeExito;
            await RecargarSeccionActualAsync();
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void MostrarError(string msg)
    {
        feedbackMessage = msg;
        isFeedbackError = true;
    }
}

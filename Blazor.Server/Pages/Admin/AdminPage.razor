@page "/admin"
@inject AuthService Auth
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Admin Dashboard</PageTitle>

<div class="win-form win-form-xl">
    <div class="win-titlebar">
        <div class="d-flex align-items-center gap-2">
            <NavLink href="/" class="win-titlebar-link">
                <span class="oi oi-window text-primary"></span>
                <span>Bestiario-NET</span>
            </NavLink>
            <span class="opacity-75">|</span>
            <span class="oi oi-wrench text-primary win-title-icon"></span>
            <span>Menú de Administrador — Bestiario</span>
        </div>
    </div>

    <WinMenuStrip OnRefresh="RecargarSeccionActualAsync" IsLoading="@isLoading" />

    <div class="win-form-content admin-content">
        @if (!Auth.EsInvestigador)
        {
            <div class="win-error-msg">
                <span class="oi oi-lock-locked me-1"></span> Acceso denegado. Redirigiendo al inicio...
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(feedbackMessage))
            {
                <div class="@(isFeedbackError ? "win-error-msg" : "alert alert-success py-1 mb-2") win-alert">
                    @feedbackMessage
                </div>
            }

            <div class="row g-3">
                <!-- Columna Izquierda: Menú Lateral -->
                <div class="col-md-3">
                    <div class="p-2 border rounded admin-sidebar">
                        <div class="fw-bold mb-2 pb-1 border-bottom admin-sidebar-title">
                            Gestión CRUD
                        </div>
                        <div class="d-flex flex-column gap-1">
                            <button class="win-btn text-start admin-nav-btn @(Crud == "categorias" ? "fw-bold border-primary" : "")"
                                    @onclick="@(() => IrASeccion("categorias"))">
                                Categorías
                            </button>
                            <button class="win-btn text-start admin-nav-btn @(Crud == "habitats" || Crud == "carHabitat" ? "fw-bold border-primary" : "")"
                                    @onclick="@(() => IrASeccion("habitats"))">
                                Hábitats
                            </button>
                            <button class="win-btn text-start admin-nav-btn @(Crud == "usuarios" ? "fw-bold border-primary" : "")"
                                    @onclick="@(() => IrASeccion("usuarios"))">
                                Usuarios
                            </button>
                            <button class="win-btn text-start admin-nav-btn @(Crud == "tiposEvidencia" ? "fw-bold border-primary" : "")"
                                    @onclick="@(() => IrASeccion("tiposEvidencia"))">
                                Tipos de Evidencia
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Columna Derecha: Contenido Principal -->
                <div class="col-md-9">
                    @if (string.IsNullOrWhiteSpace(Crud))
                    {
                        <div class="p-4 border rounded text-center bg-white admin-welcome">
                            <span class="oi oi-cog mb-2 admin-welcome-icon"></span>
                            <h5 class="admin-welcome-title">Bienvenido al menú de Admin</h5>
                            <p class="text-muted mb-0 win-text-md">
                                Seleccione una opción para gestionar en el menú de la izquierda.
                            </p>
                        </div>
                    }
                    else if (Crud == "categorias")
                    {
                        <h6 class="fw-bold mb-2 win-text-lg">Categorías</h6>
                        <div class="win-grid-container mb-3 win-grid-h170">
                            <table class="win-grid">
                                <thead>
                                    <tr>
                                        <th>Nombre (ID)</th>
                                        <th>Descripción</th>
                                        <th class="win-col-w90">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in categorias)
                                    {
                                        <tr>
                                            <td><strong>@c.Nombre</strong> <span class="text-muted win-text-xs">(ID: @c.Id.ToString().Substring(0, 8)...)</span></td>
                                            <td class="win-text-sm">@c.Descripcion</td>
                                            <td>
                                                <button class="win-btn text-danger win-btn-xs"
                                                        @onclick="@(() => SolicitarEliminar("categoria", c.Id, c.Nombre))">
                                                    Eliminar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <fieldset class="p-2 border bg-white admin-fieldset">
                                    <legend class="fw-bold admin-legend">Crear Categoría</legend>
                                    <div class="mb-2">
                                        <label class="win-label">Nombre:</label>
                                        <input class="win-textbox w-100" @bind="catNuevaNombre" maxlength="20" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="win-label">Descripción:</label>
                                        <input class="win-textbox w-100" @bind="catNuevaDesc" maxlength="100" />
                                    </div>
                                    <button class="win-btn" @onclick="CrearCategoriaAsync" disabled="@isLoading">Crear</button>
                                </fieldset>
                            </div>
                            <div class="col-md-6">
                                <fieldset class="p-2 border bg-white admin-fieldset">
                                    <legend class="fw-bold admin-legend">Actualizar Categoría</legend>
                                    <div class="mb-2">
                                        <label class="win-label">Seleccionar:</label>
                                        <SearchableSelect TValue="string" Value="@catEditId" ValueChanged="OnSeleccionarCatEdit"
                                                          Options="@(new[] { new SelectOption<string>(string.Empty, "-- Seleccione --") }.Concat(categorias.Select(c => new SelectOption<string>(c.Id.ToString(), $"{c.Nombre} ({c.Id.ToString().Substring(0, 8)})"))))" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="win-label">Nombre:</label>
                                        <input class="win-textbox w-100" @bind="catEditNombre" maxlength="20" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="win-label">Descripción:</label>
                                        <input class="win-textbox w-100" @bind="catEditDesc" maxlength="100" />
                                    </div>
                                    <button class="win-btn" @onclick="ActualizarCategoriaAsync" disabled="@isLoading">Actualizar</button>
                                </fieldset>
                            </div>
                        </div>
                    }
                    else if (Crud == "habitats")
                    {
                        <h6 class="fw-bold mb-2 win-text-lg">Hábitats</h6>
                        <div class="win-grid-container mb-3 win-grid-h170">
                            <table class="win-grid">
                                <thead>
                                    <tr>
                                        <th>Nombre (ID)</th>
                                        <th>Localización</th>
                                        <th class="win-col-w155">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var h in habitats)
                                    {
                                        <tr>
                                            <td><strong>@h.Nombre</strong> <span class="text-muted win-text-xs">(ID: @h.Id.ToString().Substring(0, 8)...)</span></td>
                                            <td class="win-text-sm">@h.Localizacion</td>
                                            <td>
                                                <div class="d-flex gap-1">
                                                    <button class="win-btn win-btn-xs"
                                                            @onclick="@(() => IrACaracteristicasHabitat(h.Id))">
                                                        Ver más
                                                    </button>
                                                    <button class="win-btn text-danger win-btn-xs"
                                                            @onclick="@(() => SolicitarEliminar("habitat", h.Id, h.Nombre))">
                                                        Eliminar
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <fieldset class="p-2 border bg-white admin-fieldset">
                                    <legend class="fw-bold admin-legend">Crear Hábitat</legend>
                                    <div class="mb-2">
                                        <label class="win-label">Nombre:</label>
                                        <input class="win-textbox w-100" @bind="habNuevoNombre" maxlength="60" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="win-label">Localización:</label>
                                        <input class="win-textbox w-100" @bind="habNuevaLoc" maxlength="120" />
                                    </div>
                                    <button class="win-btn" @onclick="CrearHabitatAsync" disabled="@isLoading">Crear</button>
                                </fieldset>
                            </div>
                            <div class="col-md-6">
                                <fieldset class="p-2 border bg-white admin-fieldset">
                                    <legend class="fw-bold admin-legend">Actualizar Hábitat</legend>
                                    <div class="mb-2">
                                        <label class="win-label">Seleccionar:</label>
                                        <SearchableSelect TValue="string" Value="@habEditId" ValueChanged="OnSeleccionarHabEdit"
                                                          Options="@(new[] { new SelectOption<string>(string.Empty, "-- Seleccione --") }.Concat(habitats.Select(h => new SelectOption<string>(h.Id.ToString(), $"{h.Nombre} ({h.Id.ToString().Substring(0, 8)})"))))" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="win-label">Nombre:</label>
                                        <input class="win-textbox w-100" @bind="habEditNombre" maxlength="60" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="win-label">Localización:</label>
                                        <input class="win-textbox w-100" @bind="habEditLoc" maxlength="120" />
                                    </div>
                                    <button class="win-btn" @onclick="ActualizarHabitatAsync" disabled="@isLoading">Actualizar</button>
                                </fieldset>
                            </div>
                        </div>
                    }
                    else if (Crud == "carHabitat")
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0 win-text-lg">
                                Características del Hábitat: @(habitatActual?.Nombre ?? "-")
                            </h6>
                            <button class="win-btn win-btn-back win-btn-md" @onclick="@(() => IrASeccion("habitats"))">
                                &lt;- Volver
                            </button>
                        </div>

                        <div class="win-grid-container mb-3 win-grid-h160">
                            <table class="win-grid">
                                <thead>
                                    <tr>
                                        <th class="win-col-w60">Nro.</th>
                                        <th>Descripción</th>
                                        <th class="win-col-w90">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (habitatActual == null || !habitatActual.Caracteristicas.Any())
                                    {
                                        <tr><td colspan="3" class="text-center text-muted py-3">Sin características registradas.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var ch in habitatActual.Caracteristicas.OrderBy(x => x.NroCaracteristica))
                                        {
                                            <tr>
                                                <td>#@ch.NroCaracteristica</td>
                                                <td class="win-text-sm">@ch.Descripcion</td>
                                                <td>
                                                    <button class="win-btn text-danger win-btn-xs"
                                                            @onclick="@(() => EliminarCaracteristicaAsync(ch.NroCaracteristica))">
                                                        Eliminar
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <fieldset class="p-2 border bg-white admin-fieldset">
                                    <legend class="fw-bold admin-legend">Crear Característica</legend>
                                    <div class="mb-2">
                                        <label class="win-label">Descripción:</label>
                                        <input class="win-textbox w-100" @bind="carNuevaDesc" maxlength="200" />
                                    </div>
                                    <button class="win-btn" @onclick="CrearCaracteristicaAsync" disabled="@isLoading">Crear</button>
                                </fieldset>
                            </div>
                            <div class="col-md-6">
                                <fieldset class="p-2 border bg-white admin-fieldset">
                                    <legend class="fw-bold admin-legend">Actualizar Característica</legend>
                                    <div class="mb-2">
                                        <label class="win-label">Característica actual:</label>
                                        <SearchableSelect TValue="int" @bind-Value="carEditNro"
                                                          Options="@(new[] { new SelectOption<int>(0, "-- Seleccione --") }.Concat((habitatActual?.Caracteristicas ?? Enumerable.Empty<CaracteristicaHabitatDTO>()).OrderBy(x => x.NroCaracteristica).Select(ch => new SelectOption<int>(ch.NroCaracteristica, $"#{ch.NroCaracteristica} — {ch.Descripcion}"))))" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="win-label">Nueva descripción:</label>
                                        <input class="win-textbox w-100" @bind="carEditDesc" maxlength="200" />
                                    </div>
                                    <button class="win-btn" @onclick="ActualizarCaracteristicaAsync" disabled="@isLoading">Actualizar</button>
                                </fieldset>
                            </div>
                        </div>
                    }
                    else if (Crud == "usuarios")
                    {
                        <h6 class="fw-bold mb-2 win-text-lg">Usuarios (Lectores)</h6>
                        <div class="win-grid-container mb-3 win-grid-h170">
                            <table class="win-grid">
                                <thead>
                                    <tr>
                                        <th>Correo (ID)</th>
                                        <th class="win-col-w120">Notificaciones</th>
                                        <th class="win-col-w90">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in lectores)
                                    {
                                        <tr>
                                            <td><strong>@u.Correo</strong> <span class="text-muted win-text-xs">(ID: @u.Id.ToString().Substring(0, 8)...)</span></td>
                                            <td class="win-text-sm">@(u.RecibirNotificaciones ? "Sí" : "No")</td>
                                            <td>
                                                <button class="win-btn text-danger win-btn-xs"
                                                        @onclick="@(() => SolicitarEliminar("usuario", u.Id, u.Correo))">
                                                    Eliminar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <fieldset class="p-2 border bg-white admin-fieldset">
                                    <legend class="fw-bold admin-legend">Crear Lector</legend>
                                    <div class="mb-2">
                                        <label class="win-label">Correo:</label>
                                        <input type="email" class="win-textbox w-100" @bind="lecNuevoCorreo" maxlength="100" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="win-label">Contraseña:</label>
                                        <input type="password" class="win-textbox w-100" @bind="lecNuevoPass" maxlength="100" />
                                    </div>
                                    <div class="mb-2 form-check">
                                        <input type="checkbox" class="form-check-input" id="chkLecNuevoNotif" @bind="lecNuevoNotif" />
                                        <label class="form-check-label" for="chkLecNuevoNotif">Recibir notificaciones</label>
                                    </div>
                                    <button class="win-btn" @onclick="CrearLectorAsync" disabled="@isLoading">Crear</button>
                                </fieldset>
                            </div>
                            <div class="col-md-6">
                                <fieldset class="p-2 border bg-white admin-fieldset">
                                    <legend class="fw-bold admin-legend">Actualizar Lector</legend>
                                    <div class="mb-2">
                                        <label class="win-label">Seleccionar:</label>
                                        <SearchableSelect TValue="string" Value="@lecEditId" ValueChanged="OnSeleccionarLecEdit"
                                                          Options="@(new[] { new SelectOption<string>(string.Empty, "-- Seleccione --") }.Concat(lectores.Select(u => new SelectOption<string>(u.Id.ToString(), $"{u.Correo} ({u.Id.ToString().Substring(0, 8)})"))))" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="win-label">Correo:</label>
                                        <input type="email" class="win-textbox w-100" @bind="lecEditCorreo" maxlength="100" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="win-label">Nueva contraseña (opcional):</label>
                                        <input type="password" class="win-textbox w-100" @bind="lecEditPass" maxlength="100" />
                                    </div>
                                    <div class="mb-2 form-check">
                                        <input type="checkbox" class="form-check-input" id="chkLecEditNotif" @bind="lecEditNotif" />
                                        <label class="form-check-label" for="chkLecEditNotif">Recibir notificaciones</label>
                                    </div>
                                    <button class="win-btn" @onclick="ActualizarLectorAsync" disabled="@isLoading">Actualizar</button>
                                </fieldset>
                            </div>
                        </div>
                    }
                    else if (Crud == "tiposEvidencia")
                    {
                        <h6 class="fw-bold mb-2 win-text-lg">Tipos de Evidencia</h6>
                        <div class="win-grid-container mb-3 win-grid-h170">
                            <table class="win-grid">
                                <thead>
                                    <tr>
                                        <th>Descripción (ID)</th>
                                        <th class="win-col-w130">ResourceType</th>
                                        <th class="win-col-w90">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in tiposEvidencia)
                                    {
                                        <tr>
                                            <td><strong>@t.Descripcion</strong> <span class="text-muted win-text-xs">(ID: @t.Id.ToString().Substring(0, 8)...)</span></td>
                                            <td class="win-text-sm">@t.ResourceType</td>
                                            <td>
                                                <button class="win-btn text-danger win-btn-xs"
                                                        @onclick="@(() => SolicitarEliminar("tipoEvidencia", t.Id, t.Descripcion))">
                                                    Eliminar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <fieldset class="p-2 border bg-white admin-fieldset">
                                    <legend class="fw-bold admin-legend">Crear Tipo de Evidencia</legend>
                                    <div class="mb-2">
                                        <label class="win-label">Descripción:</label>
                                        <input class="win-textbox w-100" @bind="tipoNuevaDesc" maxlength="80" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="win-label">ResourceType (ej. image, video, raw):</label>
                                        <input class="win-textbox w-100" @bind="tipoNuevoRes" maxlength="40" />
                                    </div>
                                    <button class="win-btn" @onclick="CrearTipoEvidenciaAsync" disabled="@isLoading">Crear</button>
                                </fieldset>
                            </div>
                            <div class="col-md-6">
                                <fieldset class="p-2 border bg-white admin-fieldset">
                                    <legend class="fw-bold admin-legend">Actualizar Tipo de Evidencia</legend>
                                    <div class="mb-2">
                                        <label class="win-label">Seleccionar:</label>
                                        <SearchableSelect TValue="string" Value="@tipoEditId" ValueChanged="OnSeleccionarTipoEdit"
                                                          Options="@(new[] { new SelectOption<string>(string.Empty, "-- Seleccione --") }.Concat(tiposEvidencia.Select(t => new SelectOption<string>(t.Id.ToString(), $"{t.Descripcion} ({t.Id.ToString().Substring(0, 8)})"))))" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="win-label">Descripción:</label>
                                        <input class="win-textbox w-100" @bind="tipoEditDesc" maxlength="80" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="win-label">ResourceType:</label>
                                        <input class="win-textbox w-100" @bind="tipoEditRes" maxlength="40" />
                                    </div>
                                    <button class="win-btn" @onclick="ActualizarTipoEvidenciaAsync" disabled="@isLoading">Actualizar</button>
                                </fieldset>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        <div class="win-btn-action-bar">
            <div class="me-auto">
                <WinBackButton />
            </div>
        </div>
    </div>

    <div class="win-statusbar">
        <span>Admin Dashboard</span>
        <span>@(string.IsNullOrWhiteSpace(Crud) ? "Inicio Admin" : $"Sección: {Crud}")</span>
    </div>
</div>

<ConfirmModal IsOpen="@isConfirmDeleteOpen"
              Title="Confirmar eliminación"
              Message="@($"¿Está seguro que desea eliminar '{deleteTargetLabel}'?")"
              OnConfirm="ConfirmarEliminarAsync"
              OnCancel="@(() => isConfirmDeleteOpen = false)" />

@code {
    [SupplyParameterFromQuery(Name = "crud")] public string? Crud { get; set; }
    [SupplyParameterFromQuery(Name = "idHabitat")] public Guid? IdHabitat { get; set; }

    private bool isLoading = false;
    private string? feedbackMessage;
    private bool isFeedbackError = false;

    private List<CategoriaDTO> categorias = new();
    private List<HabitatDTO> habitats = new();
    private HabitatDTO? habitatActual;
    private List<LectorDTO> lectores = new();
    private List<TipoEvidenciaDTO> tiposEvidencia = new();

    // Categorias forms
    private string catNuevaNombre = string.Empty;
    private string catNuevaDesc = string.Empty;
    private string catEditId = string.Empty;
    private string catEditNombre = string.Empty;
    private string catEditDesc = string.Empty;

    // Habitats forms
    private string habNuevoNombre = string.Empty;
    private string habNuevaLoc = string.Empty;
    private string habEditId = string.Empty;
    private string habEditNombre = string.Empty;
    private string habEditLoc = string.Empty;

    // Caracteristica Habitat forms
    private string carNuevaDesc = string.Empty;
    private int carEditNro = 0;
    private string carEditDesc = string.Empty;

    // Lectores forms
    private string lecNuevoCorreo = string.Empty;
    private string lecNuevoPass = string.Empty;
    private bool lecNuevoNotif = true;
    private string lecEditId = string.Empty;
    private string lecEditCorreo = string.Empty;
    private string lecEditPass = string.Empty;
    private bool lecEditNotif = true;

    // Tipos Evidencia forms
    private string tipoNuevaDesc = string.Empty;
    private string tipoNuevoRes = "image";
    private string tipoEditId = string.Empty;
    private string tipoEditDesc = string.Empty;
    private string tipoEditRes = string.Empty;

    // Confirmación eliminar
    private bool isConfirmDeleteOpen = false;
    private string deleteTipo = string.Empty;
    private Guid deleteId;
    private string deleteTargetLabel = string.Empty;

    protected override void OnInitialized()
    {
        Auth.OnChange += OnAuthChanged;
    }

    public void Dispose()
    {
        Auth.OnChange -= OnAuthChanged;
    }

    private void OnAuthChanged()
    {
        InvokeAsync(async () =>
        {
            if (!Auth.IsInitializing && !Auth.EsInvestigador)
            {
                Navigation.NavigateTo("/");
                return;
            }
            await RecargarSeccionActualAsync();
            StateHasChanged();
        });
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Auth.IsInitializing && !Auth.EsInvestigador)
        {
            Navigation.NavigateTo("/");
            return;
        }
        await RecargarSeccionActualAsync();
    }

    private void IrASeccion(string seccion)
    {
        feedbackMessage = null;
        Navigation.NavigateTo($"/admin?crud={seccion}");
    }

    private void IrACaracteristicasHabitat(Guid id)
    {
        feedbackMessage = null;
        Navigation.NavigateTo($"/admin?crud=carHabitat&idHabitat={id}");
    }

    private async Task RecargarSeccionActualAsync()
    {
        if (!Auth.EsInvestigador || string.IsNullOrWhiteSpace(Crud)) return;

        try
        {
            isLoading = true;
            if (Crud == "categorias")
            {
                categorias = (await CategoriaApiClient.GetAllAsync()).ToList();
            }
            else if (Crud == "habitats")
            {
                habitats = (await HabitatApiClient.GetAllAsync()).ToList();
            }
            else if (Crud == "carHabitat" && IdHabitat.HasValue)
            {
                habitatActual = await HabitatApiClient.GetAsync(IdHabitat.Value);
            }
            else if (Crud == "usuarios")
            {
                var todos = await UsuarioApiClient.GetAllAsync();
                lectores = todos.OfType<LectorDTO>().ToList();
            }
            else if (Crud == "tiposEvidencia")
            {
                tiposEvidencia = (await TipoEvidenciaApiClient.GetAllAsync()).ToList();
            }
        }
        catch (Exception ex)
        {
            MostrarError($"Error al cargar datos: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    // --- Categorias ---
    private void OnSeleccionarCatEdit(string? val)
    {
        catEditId = val ?? string.Empty;
        if (Guid.TryParse(catEditId, out var id))
        {
            var cat = categorias.FirstOrDefault(c => c.Id == id);
            catEditNombre = cat?.Nombre ?? string.Empty;
            catEditDesc = cat?.Descripcion ?? string.Empty;
        }
    }

    private async Task CrearCategoriaAsync()
    {
        if (string.IsNullOrWhiteSpace(catNuevaNombre) || string.IsNullOrWhiteSpace(catNuevaDesc))
        {
            MostrarError("Nombre y descripción son requeridos.");
            return;
        }
        await EjecutarAccionAsync(async () =>
        {
            await CategoriaApiClient.AddAsync(new CategoriaDTO { Nombre = catNuevaNombre.Trim(), Descripcion = catNuevaDesc.Trim() });
            catNuevaNombre = string.Empty;
            catNuevaDesc = string.Empty;
        }, "Categoría creada correctamente.");
    }

    private async Task ActualizarCategoriaAsync()
    {
        if (!Guid.TryParse(catEditId, out var id) || string.IsNullOrWhiteSpace(catEditNombre) || string.IsNullOrWhiteSpace(catEditDesc))
        {
            MostrarError("Seleccione una categoría y complete nombre y descripción.");
            return;
        }
        await EjecutarAccionAsync(async () =>
        {
            await CategoriaApiClient.UpdateAsync(new CategoriaDTO { Id = id, Nombre = catEditNombre.Trim(), Descripcion = catEditDesc.Trim() });
        }, "Categoría actualizada correctamente.");
    }

    // --- Habitats ---
    private void OnSeleccionarHabEdit(string? val)
    {
        habEditId = val ?? string.Empty;
        if (Guid.TryParse(habEditId, out var id))
        {
            var h = habitats.FirstOrDefault(x => x.Id == id);
            habEditNombre = h?.Nombre ?? string.Empty;
            habEditLoc = h?.Localizacion ?? string.Empty;
        }
    }

    private async Task CrearHabitatAsync()
    {
        if (string.IsNullOrWhiteSpace(habNuevoNombre) || string.IsNullOrWhiteSpace(habNuevaLoc))
        {
            MostrarError("Nombre y localización son requeridos.");
            return;
        }
        await EjecutarAccionAsync(async () =>
        {
            await HabitatApiClient.AddAsync(new HabitatDTO { Nombre = habNuevoNombre.Trim(), Localizacion = habNuevaLoc.Trim() });
            habNuevoNombre = string.Empty;
            habNuevaLoc = string.Empty;
        }, "Hábitat creado correctamente.");
    }

    private async Task ActualizarHabitatAsync()
    {
        if (!Guid.TryParse(habEditId, out var id) || string.IsNullOrWhiteSpace(habEditNombre) || string.IsNullOrWhiteSpace(habEditLoc))
        {
            MostrarError("Seleccione un hábitat y complete nombre y localización.");
            return;
        }
        var existente = habitats.FirstOrDefault(x => x.Id == id);
        if (existente == null) return;

        await EjecutarAccionAsync(async () =>
        {
            existente.Nombre = habEditNombre.Trim();
            existente.Localizacion = habEditLoc.Trim();
            await HabitatApiClient.UpdateAsync(existente);
        }, "Hábitat actualizado correctamente.");
    }

    // --- Caracteristicas de Habitat ---
    private async Task CrearCaracteristicaAsync()
    {
        if (habitatActual == null || string.IsNullOrWhiteSpace(carNuevaDesc))
        {
            MostrarError("La descripción es requerida.");
            return;
        }
        await EjecutarAccionAsync(async () =>
        {
            int nextNro = habitatActual.Caracteristicas.Any()
                ? habitatActual.Caracteristicas.Max(c => c.NroCaracteristica) + 1
                : 1;
            habitatActual.Caracteristicas.Add(new CaracteristicaHabitatDTO
            {
                IdHabitat = habitatActual.Id,
                NroCaracteristica = nextNro,
                Descripcion = carNuevaDesc.Trim()
            });
            await HabitatApiClient.UpdateAsync(habitatActual);
            carNuevaDesc = string.Empty;
        }, "Característica agregada.");
    }

    private async Task ActualizarCaracteristicaAsync()
    {
        if (habitatActual == null || carEditNro <= 0 || string.IsNullOrWhiteSpace(carEditDesc))
        {
            MostrarError("Seleccione una característica e ingrese la nueva descripción.");
            return;
        }
        var item = habitatActual.Caracteristicas.FirstOrDefault(c => c.NroCaracteristica == carEditNro);
        if (item == null) return;

        await EjecutarAccionAsync(async () =>
        {
            item.Descripcion = carEditDesc.Trim();
            await HabitatApiClient.UpdateAsync(habitatActual);
            carEditNro = 0;
            carEditDesc = string.Empty;
        }, "Característica actualizada.");
    }

    private async Task EliminarCaracteristicaAsync(int nro)
    {
        if (habitatActual == null) return;
        await EjecutarAccionAsync(async () =>
        {
            habitatActual.Caracteristicas.RemoveAll(c => c.NroCaracteristica == nro);
            await HabitatApiClient.UpdateAsync(habitatActual);
        }, "Característica eliminada.");
    }


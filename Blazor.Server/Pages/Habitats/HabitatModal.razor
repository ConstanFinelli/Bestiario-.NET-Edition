@inject AuthService Auth

@if (IsOpen)
{
    <div class="win-modal-overlay">
        <div class="win-modal-dialog" style="width: 600px;">
            <div class="win-titlebar">
                <div class="d-flex align-items-center gap-1">
                    <span class="oi oi-map-marker text-primary" style="font-size: 11px;"></span>
                    <span>Hábitat (Maestro / Detalle)</span>
                </div>
                <div class="win-titlebar-controls">
                    <button class="win-titlebar-btn close" title="Cerrar" @onclick="Cancel" disabled="@isSaving">✕</button>
                </div>
            </div>

            <div class="win-form-content" style="padding: 16px 20px; max-height: 80vh; overflow-y: auto;">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="win-error-msg mb-2">
                        <span class="oi oi-warning me-1"></span> @errorMessage
                    </div>
                }

                <fieldset style="border: 1px solid #c0c0c0; padding: 10px 14px; margin-bottom: 12px; background: #fafafa;">
                    <legend style="font-size: 11px; font-weight: bold; width: auto; padding: 0 4px; margin-bottom: 0;">
                        Datos del Hábitat
                    </legend>

                    @if (Mode == FormMode.Update)
                    {
                        <div class="row align-items-center mb-2">
                            <div class="col-3"><label class="win-label">Id:</label></div>
                            <div class="col-9"><input type="text" class="win-textbox w-100" value="@Habitat.Id" readonly /></div>
                        </div>
                    }

                    <div class="row align-items-center mb-2">
                        <div class="col-3"><label class="win-label">Nombre:</label></div>
                        <div class="col-9">
                            <input type="text" class="win-textbox w-100 @(nombreInvalido ? "win-field-error" : "")"
                                   @bind="Habitat.Nombre" maxlength="60" disabled="@(isSaving || !Auth.EsInvestigador)" />
                        </div>
                    </div>

                    <div class="row align-items-center mb-2">
                        <div class="col-3"><label class="win-label">Localización:</label></div>
                        <div class="col-9">
                            <input type="text" class="win-textbox w-100 @(localizacionInvalida ? "win-field-error" : "")"
                                   @bind="Habitat.Localizacion" maxlength="120" disabled="@(isSaving || !Auth.EsInvestigador)" />
                        </div>
                    </div>

                    <div class="row align-items-center mb-1">
                        <div class="col-3"><label class="win-label">Latitud / Long.:</label></div>
                        <div class="col-4">
                            <input type="number" step="0.0001" min="-90" max="90" class="win-textbox w-100"
                                   @bind="Habitat.Latitud" disabled="@(isSaving || !Auth.EsInvestigador)" />
                        </div>
                        <div class="col-5">
                            <input type="number" step="0.0001" min="-180" max="180" class="win-textbox w-100"
                                   @bind="Habitat.Longitud" disabled="@(isSaving || !Auth.EsInvestigador)" />
                        </div>
                    </div>
                </fieldset>

                <fieldset style="border: 1px solid #c0c0c0; padding: 10px 14px; background: #fafafa;">
                    <legend style="font-size: 11px; font-weight: bold; width: auto; padding: 0 4px; margin-bottom: 0;">
                        Características (@Habitat.Caracteristicas.Count)
                    </legend>

                    <div class="win-grid-container mb-2" style="height: 140px;">
                        <table class="win-grid">
                            <thead>
                                <tr>
                                    <th style="width: 35px;">#</th>
                                    <th>Descripción</th>
                                    <th style="width: 50px; text-align: center;">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Habitat.Caracteristicas.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-2 text-muted">
                                            No hay características agregadas.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @for (int i = 0; i < Habitat.Caracteristicas.Count; i++)
                                    {
                                        var idx = i;
                                        var car = Habitat.Caracteristicas[idx];
                                        <tr>
                                            <td style="font-size: 10px; font-weight: bold;">@car.NroCaracteristica</td>
                                            <td>@car.Descripcion</td>
                                            <td style="text-align: center;">
                                                @if (Auth.EsInvestigador)
                                                {
                                                    <button type="button" class="btn btn-outline-danger btn-sm p-0 px-1"
                                                            style="font-size: 10px;"
                                                            @onclick="() => EliminarCaracteristica(idx)"
                                                            disabled="@isSaving">✕</button>
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Auth.EsInvestigador)
                    {
                        <div style="background: #ffffff; border: 1px dashed #a0a0a0; padding: 8px 10px; border-radius: 2px;">
                            <span class="fw-bold d-block mb-1" style="font-size: 11px;">+ Agregar Característica:</span>
                            <div class="row g-2 align-items-center">
                                <div class="col-10">
                                    <input type="text" class="win-textbox w-100" placeholder="Descripción de la característica..."
                                           @bind="nuevaDescripcion" disabled="@isSaving" maxlength="200" />
                                </div>
                                <div class="col-2 text-end">
                                    <button type="button" class="win-btn w-100" style="height: 24px; font-size: 11px;"
                                            @onclick="AgregarCaracteristica" disabled="@isSaving">
                                        Agregar
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </fieldset>

                <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                    @if (Auth.EsInvestigador)
                    {
                        <button type="button" class="win-btn" @onclick="Save" disabled="@isSaving">
                            @(isSaving ? "Guardando..." : "Aceptar")
                        </button>
                    }
                    <button type="button" class="win-btn" @onclick="Cancel" disabled="@isSaving">
                        @(Auth.EsInvestigador ? "Cancelar" : "Cerrar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public FormMode Mode { get; set; } = FormMode.Add;
    [Parameter] public HabitatDTO Habitat { get; set; } = new();

    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool isSaving = false;
    private string? errorMessage;
    private bool nombreInvalido = false;
    private bool localizacionInvalida = false;
    private string nuevaDescripcion = string.Empty;

    protected override void OnParametersSet()
    {
        errorMessage = null;
        nombreInvalido = false;
        localizacionInvalida = false;
        nuevaDescripcion = string.Empty;
        if (Habitat == null) Habitat = new HabitatDTO();
    }

    private void AgregarCaracteristica()
    {
        if (string.IsNullOrWhiteSpace(nuevaDescripcion))
        {
            errorMessage = "La descripción de la característica es requerida.";
            return;
        }

        errorMessage = null;
        int proximoNro = Habitat.Caracteristicas.Any() ? Habitat.Caracteristicas.Max(c => c.NroCaracteristica) + 1 : 1;
        Habitat.Caracteristicas.Add(new CaracteristicaHabitatDTO
        {
            IdHabitat = Habitat.Id,
            NroCaracteristica = proximoNro,
            Descripcion = nuevaDescripcion.Trim()
        });
        nuevaDescripcion = string.Empty;
    }

    private void EliminarCaracteristica(int index)
    {
        if (index >= 0 && index < Habitat.Caracteristicas.Count)
        {
            Habitat.Caracteristicas.RemoveAt(index);
            for (int i = 0; i < Habitat.Caracteristicas.Count; i++)
            {
                Habitat.Caracteristicas[i].NroCaracteristica = i + 1;
            }
        }
    }

    private bool ValidateInput()
    {
        nombreInvalido = string.IsNullOrWhiteSpace(Habitat.Nombre);
        localizacionInvalida = string.IsNullOrWhiteSpace(Habitat.Localizacion);

        if (nombreInvalido)
        {
            errorMessage = "El Nombre es requerido";
            return false;
        }

        if (localizacionInvalida)
        {
            errorMessage = "La Localización es requerida";
            return false;
        }

        if (Habitat.Latitud < -90 || Habitat.Latitud > 90)
        {
            errorMessage = "La latitud debe estar entre -90 y 90";
            return false;
        }

        if (Habitat.Longitud < -180 || Habitat.Longitud > 180)
        {
            errorMessage = "La longitud debe estar entre -180 y 180";
            return false;
        }

        errorMessage = null;
        return true;
    }

    private async Task Save()
    {
        if (!ValidateInput()) return;

        try
        {
            isSaving = true;
            errorMessage = null;

            foreach (var c in Habitat.Caracteristicas)
            {
                c.IdHabitat = Habitat.Id;
            }

            if (Mode == FormMode.Add)
            {
                await HabitatApiClient.AddAsync(Habitat);
            }
            else
            {
                await HabitatApiClient.UpdateAsync(Habitat);
            }

            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar hábitat: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task Cancel() => await OnCancel.InvokeAsync();
}


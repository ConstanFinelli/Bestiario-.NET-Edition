@page "/register"
@page "/auth/register"
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Bestiario - Registrarse</PageTitle>

<div class="logBody">
    <div class="logDiv">
        <header class="logContainerHeader">
            <h1 class="logContainerHeaderText">Registrarse</h1>
        </header>

        <form class="logForm" @onsubmit="RegistrarLector" @onsubmit:preventDefault>
            <section class="logInputs">
                <div class="logInput">
                    <input type="email" required placeholder=" " id="correo" @bind="correo" autofocus />
                    <label for="correo">✉️ Correo electrónico</label>
                </div>

                <div class="logInput">
                    <input type="password" required placeholder=" " id="password" @bind="password" />
                    <label for="password">🔐 Contraseña</label>
                </div>

                <div id="camposLector" class="extraFields" style="display:flex;">
                    <div class="logInput">
                        <input type="date" placeholder=" " id="fechaNacimiento" @bind="fechaNacimiento" />
                        <label for="fechaNacimiento">Fecha de nacimiento</label>
                    </div>
                </div>

                <div class="logInputCheckbox">
                    <input type="checkbox" id="recibirNotificaciones" @bind="recibirNotificaciones" />
                    <label for="recibirNotificaciones">¿Desea recibir notificaciones?</label>
                </div>
            </section>

            <aside class="logSubmitContainer">
                <a href="/login" class="backButton">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" style="width: 14px; height: 14px; fill: currentColor;">
                        <path d="M73.4 297.4C60.9 309.9 60.9 330.2 73.4 342.7L233.4 502.7C245.9 515.2 266.2 515.2 278.7 502.7C291.2 490.2 291.2 469.9 278.7 457.4L173.3 352L544 352C561.7 352 576 337.7 576 320C576 302.3 561.7 288 544 288L173.3 288L278.7 182.6C291.2 170.1 291.2 149.8 278.7 137.3C266.2 124.8 245.9 124.8 233.4 137.3L73.4 297.3z"/>
                    </svg>
                    Volver
                </a>
                <button type="submit" class="logSubmit" disabled="@isLoading">
                    @(isLoading ? "Registrando..." : "Registrarse")
                </button>
            </aside>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="errorBox">
                    <ul>
                        <li class="errorMsg">⚠️ @errorMessage</li>
                    </ul>
                </div>
            }
        </form>
    </div>
</div>

@code {
    private string correo = "";
    private string password = "";
    private DateTime fechaNacimiento = DateTime.Today.AddYears(-20);
    private bool recibirNotificaciones = true;
    private string? errorMessage;
    private bool isLoading = false;

    private async Task RegistrarLector()
    {
        if (string.IsNullOrWhiteSpace(correo) || !correo.Contains("@"))
        {
            errorMessage = "Ingrese un correo electrónico válido.";
            return;
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "La contraseña es requerida.";
            return;
        }

        try
        {
            isLoading = true;
            errorMessage = null;

            bool ok = await Auth.RegistrarLectorAsync(correo.Trim(), password, recibirNotificaciones);
            if (ok)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = "No se pudo registrar la cuenta. Verifique los datos ingresados.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}

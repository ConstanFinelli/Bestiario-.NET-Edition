@page "/auth/forgot-password"
@inject NavigationManager Navigation

<PageTitle>Bestiario - Recuperar contraseña</PageTitle>

<div class="logBody">
    <div class="logDiv">
        <header class="logContainerHeader">
            <h1 class="logContainerHeaderText">Recuperar contraseña</h1>
        </header>

        <div class="notFound" style="margin: 15px auto; width: 85%; font-size: 1.1rem; padding: 10px;">
            Aún no implementado en .NET
        </div>

        <form class="logForm" @onsubmit="MostrarMensaje" @onsubmit:preventDefault>
            <section class="logInputs">
                <div class="otherMsgs">
                    <span class="otherMsg">
                        Ingresá el correo electrónico asociado a tu cuenta.
                    </span>
                    <span class="otherMsg">
                        Te enviaremos un enlace para cambiar tu contraseña.
                    </span>
                </div>

                <div class="logInput">
                    <input type="email" required placeholder=" " id="correo" @bind="correo" autocomplete="email" />
                    <label for="correo">✉️ Correo electrónico</label>
                </div>
            </section>

            <aside class="logSubmitContainer">
                <a href="/login" class="backButton">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" style="width: 14px; height: 14px; fill: currentColor;">
                        <path d="M73.4 297.4C60.9 309.9 60.9 330.2 73.4 342.7L233.4 502.7C245.9 515.2 266.2 515.2 278.7 502.7C291.2 490.2 291.2 469.9 278.7 457.4L173.3 352L544 352C561.7 352 576 337.7 576 320C576 302.3 561.7 288 544 288L173.3 288L278.7 182.6C291.2 170.1 291.2 149.8 278.7 137.3C266.2 124.8 245.9 124.8 233.4 137.3L73.4 297.3z"/>
                    </svg>
                    Volver
                </a>
                <button type="submit" class="logSubmit">
                    Enviar correo
                </button>
            </aside>

            @if (mensajeEnviado)
            {
                <div class="errorBox">
                    <ul>
                        <li class="errorMsg">⚠️ Función no soportada: Aún no implementado</li>
                    </ul>
                </div>
            }
        </form>
    </div>
</div>

@code {
    private string correo = "";
    private bool mensajeEnviado = false;

    private void MostrarMensaje()
    {
        mensajeEnviado = true;
    }
}

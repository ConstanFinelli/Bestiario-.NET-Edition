@page "/"
@using DTOs
@using API.Clients
@inject AuthService Auth

<PageTitle>Bestiario - Inicio</PageTitle>

<section class="mainContent homeContent">
    <section class="aboutUs">
        <div class="aboutUsBg">
            <section>
                <h2>¿Quiénes somos?</h2>
                <p>
                    En Bestiario nos dedicamos a recopilar, analizar y compartir información sobre avistamientos de criaturas enigmáticas
                    alrededor del mundo. Desde leyendas ancestrales hasta testimonios recientes, nuestro objetivo es construir un registro
                    accesible y confiable que acerque a la comunidad a estos fenómenos misteriosos.
                </p>
            </section>
            <section>
                <h2>¿Que encontrarás en este sitio?</h2>
                <p>
                    Aquí encontrarás reportes de avistamientos, descripciones detalladas, mapas interactivos y artículos de investigación que
                    buscan dar contexto cultural, histórico y científico a cada caso. Creemos que cada relato, ya sea una historia transmitida
                    por generaciones o una experiencia vivida en primera persona, aporta una pieza valiosa al gran rompecabezas de lo
                    desconocido.
                </p>
            </section>
        </div>
    </section>

    <aside class="newsContent">
        <h2>Últimas noticias</h2>
        <div class="newsContainer">
            @if (isLoading)
            {
                <span class="nonContent">Cargando noticias...</span>
            }
            else if (noticias != null && noticias.Any())
            {
                @foreach (var noticia in noticias)
                {
                    <article class="new">
                        <div class="newContainer">
                            <h2>@noticia.Titulo</h2>
                            <span class="newInfo">
                                publicado @noticia.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")
                            </span>
                            <p class="newContent">
                                @noticia.Contenido
                            </p>
                        </div>
                    </article>
                }
            }
            else
            {
                <span class="nonContent">No hay noticias registradas por el momento.</span>
            }
        </div>
    </aside>
</section>

@code {
    private List<NoticiaDTO> noticias = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarNoticias();
    }

    private async Task CargarNoticias()
    {
        try
        {
            isLoading = true;
            var result = await NoticiaApiClient.GetAllAsync();
            noticias = result?.OrderByDescending(n => n.FechaPublicacion).ToList() ?? new List<NoticiaDTO>();
        }
        catch
        {
            noticias = new List<NoticiaDTO>();
        }
        finally
        {
            isLoading = false;
        }
    }
}

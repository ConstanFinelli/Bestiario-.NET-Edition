@page "/"
@inject NavigationManager Navigation
@inject AuthService Auth

<PageTitle>Bestiario-NET</PageTitle>

<div class="win-form" style="width: 940px; max-width: 96vw;">
    <div class="win-titlebar">
        <div class="d-flex align-items-center gap-1">
            <span class="oi oi-window me-1 text-primary"></span>
            <span>Bestiario-NET</span>
        </div>
    </div>

    <!-- MenuStrip Clásico -->
    <div class="win-menustrip">
        <NavLink href="/bestias" class="win-menu-item">
            Bestias
        </NavLink>
        <NavLink href="/noticias" class="win-menu-item">
            Noticias
        </NavLink>
        @if (Auth.EsLector)
        {
            <NavLink href="/solicitudes-investigador" class="win-menu-item">
                Volverse Investigador
            </NavLink>
        }
        @if (Auth.EsInvestigador)
        {
            <NavLink href="/reportes" class="win-menu-item">
                Reportes
            </NavLink>
            <NavLink href="/solicitudes-investigador" class="win-menu-item">
                Solicitudes
            </NavLink>
            <NavLink href="/admin" class="win-menu-item">
                Admin
            </NavLink>
        }
        <div class="ms-auto d-flex align-items-center gap-2" style="white-space: nowrap;">
            @if (Auth.IsAuthenticated)
            {
                <span class="text-muted" style="font-size: 11px;">Usuario: <strong>@Auth.Username</strong></span>
                <button class="win-btn" style="height: 20px; font-size: 11px; padding: 0 8px; white-space: nowrap;" @onclick="CerrarSesion">
                    Cerrar sesión
                </button>
            }
            else
            {
                <span class="text-muted" style="font-size: 11px;">Modo <strong>Invitado</strong></span>
                <button class="win-btn" style="height: 20px; font-size: 11px; padding: 0 8px; white-space: nowrap;" @onclick="@(() => Navigation.NavigateTo("/login"))">
                    Iniciar sesión
                </button>
            }
        </div>
    </div>

    <!-- Área de Trabajo Principal (Home) -->
    <div class="win-form-content" style="min-height: 280px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;">
        <div style="background-color: #ffffff; border: 1px solid #c0c0c0; padding: 25px 40px; border-radius: 2px; box-shadow: inset 0 0 5px rgba(0,0,0,0.05); max-width: 720px;">
            <div class="mb-3">
                <span class="oi oi-book text-primary" style="font-size: 42px;"></span>
            </div>
            <h4 style="font-size: 16px; font-weight: bold; margin-bottom: 8px;">Bestiario - .NET Edition</h4>
            <p style="color: #555; font-size: 12px; margin-bottom: 20px;">
                Seleccione una opción del menú superior para comenzar a gestionar el catálogo del bestiario.
            </p>
            <div class="d-flex justify-content-center flex-wrap gap-2">
                <button class="win-btn" style="min-width: 100px; height: 26px;" @onclick="@(() => Navigation.NavigateTo("/bestias"))">
                    Bestias
                </button>
                <button class="win-btn" style="min-width: 100px; height: 26px;" @onclick="@(() => Navigation.NavigateTo("/noticias"))">
                    Noticias
                </button>
                @if (Auth.EsLector)
                {
                    <button class="win-btn" style="min-width: 140px; height: 26px;" @onclick="@(() => Navigation.NavigateTo("/solicitudes-investigador"))">
                        Volverse Investigador
                    </button>
                }
                @if (Auth.EsInvestigador)
                {
                    <button class="win-btn" style="min-width: 100px; height: 26px;" @onclick="@(() => Navigation.NavigateTo("/reportes"))">
                        Reportes
                    </button>
                    <button class="win-btn" style="min-width: 100px; height: 26px;" @onclick="@(() => Navigation.NavigateTo("/solicitudes-investigador"))">
                        Solicitudes
                    </button>
                    <button class="win-btn" style="min-width: 100px; height: 26px;" @onclick="@(() => Navigation.NavigateTo("/admin"))">
                        Admin
                    </button>
                }
            </div>
        </div>

        <!-- Últimas 3 Noticias -->
        <div style="width: 100%; max-width: 860px; margin-top: 20px; text-align: left;">
            <div class="d-flex align-items-center justify-content-between mb-2 pb-1" style="border-bottom: 1px solid #c0c0c0;">
                <span class="fw-bold" style="font-size: 12px;">
                    <span class="oi oi-bullhorn text-primary me-1"></span> Últimas Noticias
                </span>
                <button class="win-btn" style="height: 22px; font-size: 11px; padding: 0 8px;" @onclick="@(() => Navigation.NavigateTo("/noticias"))">
                    Ver todas
                </button>
            </div>

            @if (cargandoNoticias)
            {
                <div class="text-muted text-center py-3" style="font-size: 11px;">Cargando últimas noticias...</div>
            }
            else if (!string.IsNullOrEmpty(errorNoticias))
            {
                <div class="win-error-msg" style="font-size: 11px;">@errorNoticias</div>
            }
            else if (!ultimasNoticias.Any())
            {
                <div class="text-muted text-center py-3 border bg-white" style="font-size: 11px;">No hay noticias publicadas aún.</div>
            }
            else
            {
                <div class="row g-2">
                    @foreach (var noticia in ultimasNoticias)
                    {
                        <div class="col-md-4">
                            <div class="bg-white border p-2 h-100 d-flex flex-column justify-content-between" style="border-color: #c0c0c0; border-radius: 2px;">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start gap-1 mb-1">
                                        <strong style="font-size: 12px; color: #1f2937;">@noticia.Titulo</strong>
                                        <span class="text-muted" style="font-size: 10px; white-space: nowrap;">
                                            @noticia.FechaPublicacion.ToString("dd/MM/yyyy")
                                        </span>
                                    </div>
                                    <p class="mb-0 text-secondary" style="font-size: 11px; line-height: 1.4;">
                                        @noticia.Contenido
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Barra de Estado Inferior -->
    <div class="win-statusbar">
        <span>Listo</span>
        <span>Conectado a WebAPI: 5076</span>
    </div>
</div>

@code {
    private List<NoticiaDTO> ultimasNoticias = new();
    private bool cargandoNoticias = true;
    private string? errorNoticias;

    protected override async Task OnInitializedAsync()
    {
        await CargarUltimasNoticiasAsync();
    }

    private async Task CargarUltimasNoticiasAsync()
    {
        try
        {
            cargandoNoticias = true;
            errorNoticias = null;
            var todas = await NoticiaApiClient.GetAllAsync();
            ultimasNoticias = (todas ?? Enumerable.Empty<NoticiaDTO>())
                .OrderByDescending(n => n.FechaPublicacion)
                .Take(3)
                .ToList();
        }
        catch (Exception ex)
        {
            errorNoticias = $"No se pudieron cargar las noticias: {ex.Message}";
            ultimasNoticias = new();
        }
        finally
        {
            cargandoNoticias = false;
        }
    }

    private async Task CerrarSesion()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}

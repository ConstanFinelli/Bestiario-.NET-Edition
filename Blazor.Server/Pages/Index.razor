@page "/"
@inject NavigationManager Navigation
@inject AuthService Auth

<PageTitle>Bestiario-NET</PageTitle>

<div class="win-form win-form-md home-form-top">
    <div class="win-titlebar">
        <div class="d-flex align-items-center gap-1">
            <span class="oi oi-window me-1 text-primary"></span>
            <span>Bestiario-NET</span>
        </div>
    </div>

    <div class="win-menustrip">
        <NavLink href="/bestias" class="win-menu-item">
            Bestias
        </NavLink>
        <NavLink href="/noticias" class="win-menu-item">
            Noticias
        </NavLink>
        @if (Auth.EsLector)
        {
            <NavLink href="/solicitudes-investigador" class="win-menu-item">
                Volverse Investigador
            </NavLink>
        }
        @if (Auth.EsInvestigador)
        {
            <NavLink href="/reportes" class="win-menu-item">
                Reportes
            </NavLink>
            <NavLink href="/solicitudes-investigador" class="win-menu-item">
                Solicitudes
            </NavLink>
            <NavLink href="/admin" class="win-menu-item">
                Admin
            </NavLink>
        }
        <div class="ms-auto d-flex align-items-center gap-2 win-nowrap">
            @if (Auth.IsAuthenticated)
            {
                <span class="text-muted win-text-sm">Usuario: <strong>@Auth.Username</strong></span>
                <button class="win-btn win-btn-sm" @onclick="CerrarSesion">
                    Cerrar sesión
                </button>
            }
            else
            {
                <span class="text-muted win-text-sm">Modo <strong>Invitado</strong></span>
                <button class="win-btn win-btn-sm" @onclick="@(() => Navigation.NavigateTo("/login"))">
                    Iniciar sesión
                </button>
            }
        </div>
    </div>

    <div class="win-form-content home-content">
        <div class="home-welcome-card">
            <div class="mb-3">
                <span class="oi oi-book text-primary home-book-icon"></span>
            </div>
            <h4 class="home-title">Bestiario - .NET Edition</h4>
            <p class="home-subtitle">
                Seleccione una opción del menú superior para comenzar a gestionar el catálogo del bestiario.
            </p>
            <div class="d-flex justify-content-center flex-wrap gap-2">
                <button class="win-btn win-btn-lg" @onclick="@(() => Navigation.NavigateTo("/bestias"))">
                    Bestias
                </button>
                <button class="win-btn win-btn-lg" @onclick="@(() => Navigation.NavigateTo("/noticias"))">
                    Noticias
                </button>
                @if (Auth.EsLector)
                {
                    <button class="win-btn win-btn-wide" @onclick="@(() => Navigation.NavigateTo("/solicitudes-investigador"))">
                        Volverse Investigador
                    </button>
                }
                @if (Auth.EsInvestigador)
                {
                    <button class="win-btn win-btn-lg" @onclick="@(() => Navigation.NavigateTo("/reportes"))">
                        Reportes
                    </button>
                    <button class="win-btn win-btn-lg" @onclick="@(() => Navigation.NavigateTo("/solicitudes-investigador"))">
                        Solicitudes
                    </button>
                    <button class="win-btn win-btn-lg" @onclick="@(() => Navigation.NavigateTo("/admin"))">
                        Admin
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<div class="win-form win-form-md home-form-news">
    <div class="win-titlebar">
        <div class="d-flex align-items-center gap-1">
            <span class="oi oi-bullhorn text-primary"></span>
            <span>Últimas Noticias</span>
        </div>
        <button class="win-btn win-btn-sm" @onclick="@(() => Navigation.NavigateTo("/noticias"))">
            Ver todas
        </button>
    </div>

    <div class="win-form-content home-news-body">
        @if (cargandoNoticias)
        {
            <div class="text-muted text-center py-3 win-text-sm">Cargando últimas noticias...</div>
        }
        else if (!string.IsNullOrEmpty(errorNoticias))
        {
            <div class="win-error-msg win-alert">@errorNoticias</div>
        }
        else if (!ultimasNoticias.Any())
        {
            <div class="text-muted text-center py-3 border bg-white win-text-sm">No hay noticias publicadas aún.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var noticia in ultimasNoticias)
                {
                    <div class="col-md-4">
                        <div class="bg-white border p-3 h-100 d-flex flex-column justify-content-between home-news-card">
                            <div>
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2 pb-1 home-news-header">
                                    <strong class="home-news-title">@noticia.Titulo</strong>
                                    <span class="text-muted home-news-date">
                                        @noticia.FechaPublicacion.ToString("dd/MM/yyyy")
                                    </span>
                                </div>
                                <p class="mb-0 text-secondary home-news-text">
                                    @noticia.Contenido
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="win-statusbar">
        <span>Mostrando @ultimasNoticias.Count noticia(s) reciente(s)</span>
        <a href="/noticias" class="text-decoration-none home-news-link">Ir al listado completo →</a>
    </div>
</div>

@code {
    private List<NoticiaDTO> ultimasNoticias = new();
    private bool cargandoNoticias = true;
    private string? errorNoticias;

    protected override async Task OnInitializedAsync()
    {
        await CargarUltimasNoticiasAsync();
    }

    private async Task CargarUltimasNoticiasAsync()
    {
        try
        {
            cargandoNoticias = true;
            errorNoticias = null;
            var todas = await NoticiaApiClient.GetAllAsync();
            ultimasNoticias = (todas ?? Enumerable.Empty<NoticiaDTO>())
                .OrderByDescending(n => n.FechaPublicacion)
                .Take(3)
                .ToList();
        }
        catch (Exception ex)
        {
            errorNoticias = $"No se pudieron cargar las noticias: {ex.Message}";
            ultimasNoticias = new();
        }
        finally
        {
            cargandoNoticias = false;
        }
    }

    private async Task CerrarSesion()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}

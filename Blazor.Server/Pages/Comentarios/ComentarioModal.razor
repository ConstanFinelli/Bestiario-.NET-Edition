@inject AuthService Auth

@if (IsOpen)
{
    <div class="win-modal-overlay">
        <div class="win-modal-dialog" style="width: 480px;">
            <div class="win-titlebar">
                <div class="d-flex align-items-center gap-1">
                    <span class="oi oi-comment-square text-primary" style="font-size: 11px;"></span>
                    <span>Comentario</span>
                </div>
                <div class="win-titlebar-controls">
                    <button class="win-titlebar-btn close" title="Cerrar" @onclick="Cancel" disabled="@isSaving">✕</button>
                </div>
            </div>

            <div class="win-form-content" style="padding: 18px 24px;">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="win-error-msg mb-2">
                        <span class="oi oi-warning me-1"></span> @errorMessage
                    </div>
                }

                @if (Mode == FormMode.Update)
                {
                    <div class="row align-items-center mb-2">
                        <div class="col-4"><label class="win-label">Id:</label></div>
                        <div class="col-8"><input type="text" class="win-textbox w-100" value="@Comentario.Id" readonly /></div>
                    </div>
                }

                <div class="row align-items-center mb-2">
                    <div class="col-4"><label class="win-label">Bestia:</label></div>
                    <div class="col-8">
                        @if (Mode == FormMode.Update)
                        {
                            var nombreBestia = Comentario.BestiaNombre ?? Bestias.FirstOrDefault(b => b.Id == Comentario.IdBestia)?.Nombre ?? "-";
                            <input type="text" class="win-textbox w-100" value="@nombreBestia" readonly />
                        }
                        else
                        {
                            <select class="win-textbox w-100" @bind="Comentario.IdBestia" disabled="@(isSaving || !PuedeEditar)">
                                <option value="@Guid.Empty">-- Seleccione una Bestia --</option>
                                @foreach (var b in Bestias)
                                {
                                    <option value="@b.Id">@b.Nombre (@b.Peligrosidad)</option>
                                }
                            </select>
                        }
                    </div>
                </div>

                <div class="row align-items-center mb-2">
                    <div class="col-4"><label class="win-label">Autor:</label></div>
                    <div class="col-8"><input type="text" class="win-textbox w-100" value="@(Comentario.CorreoUsuario ?? Auth.Username ?? "-")" readonly /></div>
                </div>

                <div class="row align-items-center mb-2">
                    <div class="col-4"><label class="win-label">Título:</label></div>
                    <div class="col-8">
                        <input type="text" class="win-textbox w-100 @(tituloInvalido ? "win-field-error" : "")"
                               @bind="Comentario.Titulo" maxlength="100" disabled="@(isSaving || !PuedeEditar)" />
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-4 pt-1"><label class="win-label">Contenido:</label></div>
                    <div class="col-8">
                        <textarea class="win-textarea w-100 @(contenidoInvalido ? "win-field-error" : "")"
                                  @bind="Comentario.Contenido" rows="4" maxlength="500" disabled="@(isSaving || !PuedeEditar)"></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                    @if (PuedeEditar)
                    {
                        <button type="button" class="win-btn" @onclick="Save" disabled="@isSaving">
                            @(isSaving ? "Guardando..." : "Aceptar")
                        </button>
                    }
                    <button type="button" class="win-btn" @onclick="Cancel" disabled="@isSaving">
                        @(PuedeEditar ? "Cancelar" : "Cerrar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public FormMode Mode { get; set; } = FormMode.Add;
    [Parameter] public ComentarioDTO Comentario { get; set; } = new();
    [Parameter] public List<BestiaDTO> Bestias { get; set; } = new();

    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool isSaving = false;
    private string? errorMessage;
    private bool tituloInvalido = false;
    private bool contenidoInvalido = false;

    private bool PuedeEditar => Auth.EsInvestigador || (Mode == FormMode.Add && Auth.IsAuthenticated);

    protected override void OnParametersSet()
    {
        errorMessage = null;
        tituloInvalido = false;
        contenidoInvalido = false;
    }

    private bool ValidateInput()
    {
        tituloInvalido = string.IsNullOrWhiteSpace(Comentario.Titulo);
        contenidoInvalido = string.IsNullOrWhiteSpace(Comentario.Contenido);

        if (Comentario.IdBestia == Guid.Empty)
        {
            errorMessage = "Debe seleccionar una Bestia.";
            return false;
        }
        if (tituloInvalido)
        {
            errorMessage = "El título es requerido.";
            return false;
        }
        if (contenidoInvalido)
        {
            errorMessage = "El contenido es requerido.";
            return false;
        }

        errorMessage = null;
        return true;
    }

    private async Task Save()
    {
        if (!ValidateInput()) return;

        try
        {
            isSaving = true;
            errorMessage = null;

            if (Mode == FormMode.Add)
            {
                if (Comentario.IdUsuario == Guid.Empty)
                {
                    Comentario.IdUsuario = Auth.CurrentUser?.Id ?? Guid.Empty;
                }
                await ComentarioApiClient.AddAsync(Comentario);
            }
            else
            {
                await ComentarioApiClient.UpdateAsync(Comentario);
            }

            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar comentario: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task Cancel() => await OnCancel.InvokeAsync();
}

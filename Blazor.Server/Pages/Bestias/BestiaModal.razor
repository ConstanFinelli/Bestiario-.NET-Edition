@if (IsOpen)
{
    <div class="win-modal-overlay">
        <div class="win-modal-dialog win-modal-md">
            <div class="win-titlebar">
                <div class="d-flex align-items-center gap-1">
                    <span class="oi oi-window text-primary win-title-icon"></span>
                    <span>Bestia</span>
                </div>
                <div class="win-titlebar-controls">
                    <button class="win-titlebar-btn close" title="Cerrar" @onclick="Cancel" disabled="@isSaving">✕</button>
                </div>
            </div>

            <div class="win-form-content win-modal-body-lg">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="win-error-msg">
                        <span class="oi oi-warning me-1"></span> @errorMessage
                    </div>
                }

                @if (Mode == FormMode.Update)
                {
                    <div class="row align-items-center mb-2">
                        <div class="col-4">
                            <label class="win-label">Id:</label>
                        </div>
                        <div class="col-8">
                            <input type="text" class="win-textbox w-100" value="@Bestia.Id" readonly />
                        </div>
                    </div>
                }

                <div class="row align-items-center mb-2">
                    <div class="col-4">
                        <label class="win-label">Nombre:</label>
                    </div>
                    <div class="col-8">
                        <input type="text" class="win-textbox w-100 @(nombreInvalido ? "win-field-error" : "")" 
                               @bind="Bestia.Nombre" maxlength="100" disabled="@isSaving" autofocus />
                    </div>
                </div>

                <div class="row align-items-center mb-2">
                    <div class="col-4">
                        <label class="win-label">Peligrosidad:</label>
                    </div>
                    <div class="col-8">
                        <SearchableSelect TValue="string" @bind-Value="Bestia.Peligrosidad" Options="@PeligrosidadOptions" Disabled="@isSaving" />
                    </div>
                </div>

                <div class="row align-items-center mb-2">
                    <div class="col-4">
                        <label class="win-label">Estado:</label>
                    </div>
                    <div class="col-8">
                        <SearchableSelect TValue="string" @bind-Value="Bestia.Estado" Options="@EstadoOptions" Disabled="@isSaving" />
                    </div>
                </div>

                <div class="row align-items-center mb-2">
                    <div class="col-4">
                        <label class="win-label">Hábitat:</label>
                    </div>
                    <div class="col-8">
                        <SearchableSelect TValue="Guid?" @bind-Value="Bestia.IdHabitat" Options="@HabitatOptions" Disabled="@isSaving" />
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-4 pt-1">
                        <label class="win-label">Categorías:</label>
                    </div>
                    <div class="col-8">
                        <input type="text" class="win-textbox w-100 mb-1" placeholder="Escribir para buscar categoría..."
                               @bind="filtroCategoria" @bind:event="oninput" disabled="@isSaving" />
                        <div class="win-check-list">
                            @if (todasCategorias == null || !todasCategorias.Any())
                            {
                                <span class="text-muted win-text-sm">No hay categorías disponibles.</span>
                            }
                            else
                            {
                                @foreach (var cat in CategoriasFiltradas)
                                {
                                    bool isChecked = Bestia.CategoriasIds.Contains(cat.Id);
                                    <div class="form-check win-check-item">
                                        <input class="form-check-input" type="checkbox" id="cat_@cat.Id" 
                                               checked="@isChecked" 
                                               @onchange="(e) => ToggleCategoria(cat.Id, e.Value)" 
                                               disabled="@isSaving" />
                                        <label class="form-check-label" for="cat_@cat.Id">
                                            @cat.Nombre
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                    <button type="button" class="win-btn" @onclick="Save" disabled="@isSaving">
                        @(isSaving ? "Guardando..." : "Aceptar")
                    </button>
                    <button type="button" class="win-btn" @onclick="Cancel" disabled="@isSaving">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public FormMode Mode { get; set; } = FormMode.Add;
    [Parameter] public BestiaDTO Bestia { get; set; } = new BestiaDTO();

    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private List<CategoriaDTO> todasCategorias = new();
    private List<HabitatDTO> todosHabitats = new();
    private bool isSaving = false;
    private string? errorMessage;
    private bool nombreInvalido = false;

    protected override async Task OnParametersSetAsync()
    {
        errorMessage = null;
        nombreInvalido = false;

        if (IsOpen)
        {
            if (string.IsNullOrEmpty(Bestia.Peligrosidad))
                Bestia.Peligrosidad = "Media";
            if (string.IsNullOrEmpty(Bestia.Estado))
                Bestia.Estado = "pendiente";

            try
            {
                var cats = await CategoriaApiClient.GetAllAsync();
                todasCategorias = cats?.ToList() ?? new List<CategoriaDTO>();
            }
            catch
            {
                todasCategorias = new List<CategoriaDTO>();
            }

            try
            {
                var habs = await HabitatApiClient.GetAllAsync();
                todosHabitats = habs?.ToList() ?? new List<HabitatDTO>();
            }
            catch
            {
                todosHabitats = new List<HabitatDTO>();
            }
        }
    }

    private string filtroCategoria = string.Empty;

    private IEnumerable<SelectOption<string>> PeligrosidadOptions => new[]
    {
        new SelectOption<string>("Baja", "Baja"),
        new SelectOption<string>("Media", "Media"),
        new SelectOption<string>("Alta", "Alta"),
        new SelectOption<string>("Muy Alta", "Muy Alta"),
        new SelectOption<string>("Extrema", "Extrema")
    };

    private IEnumerable<SelectOption<string>> EstadoOptions => new[]
    {
        new SelectOption<string>("pendiente", "pendiente"),
        new SelectOption<string>("aprobado", "aprobado")
    };

    private IEnumerable<SelectOption<Guid?>> HabitatOptions =>
        new[] { new SelectOption<Guid?>(null, "-- Sin hábitat --") }
        .Concat((todosHabitats ?? Enumerable.Empty<HabitatDTO>()).Select(h => new SelectOption<Guid?>(h.Id, h.Nombre)));

    private IEnumerable<CategoriaDTO> CategoriasFiltradas =>
        string.IsNullOrWhiteSpace(filtroCategoria)
            ? (todasCategorias ?? Enumerable.Empty<CategoriaDTO>())
            : (todasCategorias ?? Enumerable.Empty<CategoriaDTO>()).Where(c => c.Nombre.Contains(filtroCategoria, StringComparison.OrdinalIgnoreCase));

    private void ToggleCategoria(Guid idCategoria, object? isCheckedObj)
    {
        bool isChecked = isCheckedObj is bool b && b;
        if (isChecked)
        {
            if (!Bestia.CategoriasIds.Contains(idCategoria))
            {
                Bestia.CategoriasIds.Add(idCategoria);
            }
        }
        else
        {
            Bestia.CategoriasIds.Remove(idCategoria);
        }
    }

    private bool ValidateInput()
    {
        nombreInvalido = string.IsNullOrWhiteSpace(Bestia.Nombre);

        if (nombreInvalido)
        {
            errorMessage = "El Nombre es requerido";
            return false;
        }

        errorMessage = null;
        return true;
    }

    private async Task Save()
    {
        if (!ValidateInput()) return;

        try
        {
            isSaving = true;
            errorMessage = null;

            if (Mode == FormMode.Add)
            {
                await BestiaApiClient.AddAsync(Bestia);
            }
            else
            {
                await BestiaApiClient.UpdateAsync(Bestia);
            }

            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar bestia: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }
}

@page "/bestias"
@using DTOs
@using API.Clients
@inject NavigationManager Navigation
@inject AuthService Auth

<PageTitle>Bestiario - Bestias</PageTitle>

<section class="mainContent bestiasPage">
    <h1>Bestias registradas</h1>

    <div style="display: flex; justify-content: center; align-items: center; gap: 10px; margin-bottom: 1rem;">
        <input list="categorias-list" 
               class="inputFilter" 
               placeholder="--Ingrese Categoria--" 
               @bind="filtroCategoria" 
               @bind:event="oninput" 
               autocomplete="on" />

        <datalist id="categorias-list">
            @if (categorias != null)
            {
                @foreach (var cat in categorias)
                {
                    <option value="@cat.Nombre"></option>
                }
            }
        </datalist>

        <button class="btnBestia" type="button" @onclick="FiltrarBestias">
            Buscar
        </button>

        @if (!string.IsNullOrEmpty(filtroCategoria))
        {
            <button class="btnBestia" type="button" @onclick="LimpiarFiltro" style="background: #e2e8f0;">
                Limpiar
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="notFound" style="margin-bottom: 1rem;">@feedbackMessage</div>
    }

    <section class="slides">
        @if (isLoading)
        {
            <div class="notFound">Cargando bestias...</div>
        }
        else if (bestiasMostradas != null && bestiasMostradas.Any())
        {
            <div class="swiper mySwiper">
                <div class="swiper-wrapper" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 25px; padding: 20px 0;">
                    @foreach (var bestia in bestiasMostradas)
                    {
                        <article class="bestia" style="width: 320px; height: 420px; border-radius: 8px;">
                            <h1 style="font-size: 1.5rem; margin-top: 10px; padding: 0 10px;">@bestia.Nombre</h1>

                            <div style="flex: 1; width: 100%; display: flex; align-items: center; justify-content: center; background: #e5e5e5; overflow: hidden;">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="100" height="100" fill="#a0aec0">
                                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                                </svg>
                            </div>

                            <div style="padding: 5px 10px 10px; font-size: 0.9rem; color: #666;">
                                Peligrosidad: <strong>@bestia.Peligrosidad</strong>
                                @if (bestia.Estado == "pendiente")
                                {
                                    <span style="display: block; color: #c05621; font-weight: bold;">(Pendiente de aprobación)</span>
                                }
                            </div>

                            <div class="overlay-buttons">
                                <a class="btnBestia" href="/bestias/@bestia.Id/registro">Examinar</a>

                                @if (Auth.IsInvestigador)
                                {
                                    <a class="btnBestia" href="/bestias/@bestia.Id/registros-pendientes">Ver Reg. Pendientes</a>
                                    <a class="btnBestia" href="/bestias/editar/@bestia.Id">Editar</a>
                                }

                                @if (bestia.Estado == "pendiente" && Auth.IsInvestigador)
                                {
                                    <button type="button" class="btnBestia" @onclick="() => AprobarBestia(bestia.Id)">Aprobar Bestia</button>
                                }

                                @if (Auth.IsInvestigador)
                                {
                                    <button type="button" class="btnEliminar" @onclick="() => AbrirConfirmarEliminar(bestia)">Eliminar</button>
                                }
                            </div>
                        </article>
                    }
                </div>
            </div>
        }
        else
        {
            <section>
                <div class="notFound">No se pudieron encontrar Bestias.</div>
            </section>
        }
    </section>

    @if (Auth.IsAuthenticated)
    {
        <div style="margin: 30px 0;">
            <a class="btnAgregar" href="/bestias/nueva"> + Proponer Nueva Bestia</a>
        </div>
    }
</section>

<!-- Modal Confirmación Eliminación -->
<div class="modal-container @(isModalEliminarVisible ? "is-visible" : "")">
    <div class="modal-content">
        <h2 id="modal-titulo">ELIMINAR BESTIA</h2>
        <div id="modal-cuerpo" style="font-size: 1.2rem; text-align: center;">
            ¿Estás seguro que deseas eliminar a la bestia <strong>@bestiaAEliminar?.Nombre</strong>?
        </div>
        <div class="modalButtons">
            <button type="button" class="closeButton" @onclick="CerrarModalEliminar">Cancelar</button>
            <button type="button" class="deleteButton" @onclick="ConfirmarEliminar">Eliminar</button>
        </div>
    </div>
</div>

@code {
    private List<BestiaDTO> todasBestias = new();
    private List<BestiaDTO> bestiasMostradas = new();
    private List<CategoriaDTO> categorias = new();
    private string filtroCategoria = "";
    private bool isLoading = true;
    private string? feedbackMessage;

    private bool isModalEliminarVisible = false;
    private BestiaDTO? bestiaAEliminar;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            isLoading = true;
            feedbackMessage = null;

            var catsResult = await CategoriaApiClient.GetAllAsync();
            categorias = catsResult?.ToList() ?? new List<CategoriaDTO>();

            var beastsResult = await BestiaApiClient.GetAllAsync();
            todasBestias = beastsResult?.ToList() ?? new List<BestiaDTO>();

            // Si es lector o no autenticado, solo mostrar aprobadas
            if (!Auth.IsAuthenticated || Auth.IsLector)
            {
                todasBestias = todasBestias.Where(b => b.Estado != null && b.Estado.Equals("aprobado", StringComparison.OrdinalIgnoreCase)).ToList();
            }

            FiltrarBestias();
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al cargar datos: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FiltrarBestias()
    {
        if (string.IsNullOrWhiteSpace(filtroCategoria))
        {
            bestiasMostradas = new List<BestiaDTO>(todasBestias);
        }
        else
        {
            var f = filtroCategoria.Trim().ToLowerInvariant();
            bestiasMostradas = todasBestias.Where(b => 
                b.CategoriasNombres.Any(cn => cn.ToLowerInvariant().Contains(f))
            ).ToList();
        }
    }

    private void LimpiarFiltro()
    {
        filtroCategoria = "";
        FiltrarBestias();
    }

    private async Task AprobarBestia(Guid id)
    {
        try
        {
            isLoading = true;
            var b = await BestiaApiClient.GetAsync(id);
            if (b != null)
            {
                b.Estado = "aprobado";
                await BestiaApiClient.UpdateAsync(b);
            }
            feedbackMessage = "Bestia aprobada exitosamente.";
            await CargarDatos();
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al aprobar bestia: {ex.Message}";
            isLoading = false;
        }
    }

    private void AbrirConfirmarEliminar(BestiaDTO b)
    {
        bestiaAEliminar = b;
        isModalEliminarVisible = true;
    }

    private void CerrarModalEliminar()
    {
        isModalEliminarVisible = false;
        bestiaAEliminar = null;
    }

    private async Task ConfirmarEliminar()
    {
        if (bestiaAEliminar == null) return;

        try
        {
            isModalEliminarVisible = false;
            isLoading = true;
            await BestiaApiClient.DeleteAsync(bestiaAEliminar.Id);
            feedbackMessage = $"Bestia '{bestiaAEliminar.Nombre}' eliminada.";
            bestiaAEliminar = null;
            await CargarDatos();
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al eliminar bestia: {ex.Message}";
            isLoading = false;
        }
    }
}

@page "/bestias"
@inject NavigationManager Navigation
@inject AuthService Auth

<PageTitle>Bestias</PageTitle>

<div class="win-form" style="width: 940px; max-width: 96vw;">
    <!-- Barra de Título Windows -->
    <div class="win-titlebar">
        <div class="d-flex align-items-center gap-1">
            <span class="oi oi-bug text-primary"></span>
            <span>Bestias</span>
        </div>
    </div>

    <!-- MenuStrip de Navegación -->
    <WinMenuStrip OnRefresh="CargarBestias" IsLoading="@isLoading" />

    <!-- Contenido del Formulario -->
    <div class="win-form-content">
        @if (!string.IsNullOrEmpty(feedbackMessage))
        {
            <div class="@(isFeedbackError ? "win-error-msg" : "alert alert-success py-1 mb-2")" style="font-size: 11px;">
                @feedbackMessage
            </div>
        }

        <!-- Grilla DataGridView -->
        <div class="win-grid-container" style="height: 260px;">
            <table class="win-grid">
                <thead>
                    <tr>
                        <th class="win-grid-row-header-th"></th>
                        <th style="width: 140px;">Id</th>
                        <th style="width: 180px;">Nombre</th>
                        <th style="width: 110px;">Peligrosidad</th>
                        <th style="width: 90px;">Estado</th>
                        <th style="width: 150px;">Hábitat</th>
                        <th>Categorías</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Cargando bestias...
                            </td>
                        </tr>
                    }
                    else if (bestias == null || !bestias.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No hay bestias registradas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in bestias)
                        {
                            bool isSelected = selectedBestia?.Id == b.Id;
                            <tr class="@(isSelected ? "selected" : "")" 
                                @onclick="() => SeleccionarFila(b)"
                                @ondblclick="VerRegistroVigenteDeBestia">
                                <td class="win-grid-row-header">
                                    @(isSelected ? "▶" : "")
                                </td>
                                <td style="font-family: monospace; font-size: 10px;">@b.Id.ToString().Substring(0, 8)...</td>
                                <td>@b.Nombre</td>
                                <td>@b.Peligrosidad</td>
                                <td>
                                    <span class="badge @(b.Estado == "aprobado" ? "bg-success" : "bg-warning text-dark")" style="font-size: 10px;">
                                        @b.Estado
                                    </span>
                                </td>
                                <td>@(string.IsNullOrEmpty(b.HabitatNombre) ? "-" : b.HabitatNombre)</td>
                                <td>@(b.CategoriasNombres.Any() ? string.Join(", ", b.CategoriasNombres) : "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Botones de Acción -->
        <div class="win-btn-action-bar">
            @if (selectedBestia != null)
            {
                <button class="win-btn" @onclick="VerRegistroVigenteDeBestia" disabled="@isLoading">
                    Ver Último Registro
                </button>
                @if (Auth.EsInvestigador)
                {
                    <button class="win-btn" @onclick="AbrirModalPendientes" disabled="@isLoading">
                        Pendientes de Bestia
                    </button>
                }
            }
            @if (Auth.EsInvestigador)
            {
                <button class="win-btn me-auto" @onclick="AbrirModalTodosPendientes" disabled="@isLoading">
                    Ver Todos los Pendientes
                </button>
            }
            else
            {
                <div class="me-auto"></div>
            }
            @if (Auth.EsInvestigador)
            {
                <button class="win-btn" @onclick="AbrirModalEliminar" disabled="@(selectedBestia == null || isLoading)">
                    Eliminar
                </button>
                <button class="win-btn" @onclick="AbrirModalActualizar" disabled="@(selectedBestia == null || isLoading)">
                    Actualizar
                </button>
                <button class="win-btn" @onclick="AbrirModalAgregar" disabled="@isLoading">
                    Agregar
                </button>
            }
        </div>
    </div>

    <!-- Barra de Estado Inferior -->
    <div class="win-statusbar">
        <span>@(bestias?.Count ?? 0) elemento(s) cargado(s)</span>
        <span>@(selectedBestia != null ? $"Seleccionado: {selectedBestia.Nombre}" : "Ningún elemento seleccionado")</span>
    </div>
</div>

<!-- Modal Detalle -->
<BestiaModal IsOpen="@isModalOpen" 
             Mode="@modalMode" 
             Bestia="@bestiaParaEditar" 
             OnSaved="@OnBestiaGuardada" 
             OnCancel="@CerrarModal" />

<!-- Diálogo Confirmación Eliminación -->
<ConfirmModal IsOpen="@isConfirmDeleteOpen"
              Title="Confirmar eliminación"
              Message="@($"¿Está seguro que desea eliminar la bestia '{selectedBestia?.Nombre}'?")"
              ConfirmButtonText="Sí"
              OnConfirm="@EliminarBestiaConfirmada"
              OnCancel="@(() => isConfirmDeleteOpen = false)" />

@implements IDisposable

@code {
    private List<BestiaDTO> bestias = new();
    private BestiaDTO? selectedBestia;
    private BestiaDTO bestiaParaEditar = new();
    private FormMode modalMode = FormMode.Add;

    private bool isLoading = true;
    private bool isModalOpen = false;
    private bool isConfirmDeleteOpen = false;

    private string? feedbackMessage;
    private bool isFeedbackError = false;

    protected override async Task OnInitializedAsync()
    {
        Auth.OnChange += HandleAuthStateChanged;
        await CargarBestias();
    }

    private async void HandleAuthStateChanged()
    {
        await InvokeAsync(async () =>
        {
            await CargarBestias();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Auth.OnChange -= HandleAuthStateChanged;
    }

    private async Task CargarBestias()
    {
        try
        {
            isLoading = true;
            feedbackMessage = null;
            selectedBestia = null;

            var result = await BestiaApiClient.GetAllAsync();
            bestias = result?.ToList() ?? new List<BestiaDTO>();

            if (!Auth.EsInvestigador)
            {
                bestias = bestias.Where(b => b.Estado != null && b.Estado.Equals("aprobado", StringComparison.OrdinalIgnoreCase)).ToList();
            }

            if (bestias.Count > 0)
            {
                selectedBestia = bestias[0];
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al cargar bestias: {ex.Message}";
            isFeedbackError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SeleccionarFila(BestiaDTO b)
    {
        selectedBestia = b;
    }

    private void AbrirModalAgregar()
    {
        modalMode = FormMode.Add;
        bestiaParaEditar = new BestiaDTO();
        isModalOpen = true;
    }

    private async Task AbrirModalActualizar()
    {
        if (selectedBestia == null) return;

        try
        {
            isLoading = true;
            var fresca = await BestiaApiClient.GetAsync(selectedBestia.Id);
            if (fresca != null)
            {
                bestiaParaEditar = new BestiaDTO
                {
                    Id = fresca.Id,
                    Nombre = fresca.Nombre,
                    Peligrosidad = fresca.Peligrosidad,
                    Estado = fresca.Estado,
                    IdHabitat = fresca.IdHabitat,
                    HabitatNombre = fresca.HabitatNombre,
                    CategoriasIds = new List<Guid>(fresca.CategoriasIds),
                    CategoriasNombres = new List<string>(fresca.CategoriasNombres)
                };
                modalMode = FormMode.Update;
                isModalOpen = true;
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al obtener datos: {ex.Message}";
            isFeedbackError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CerrarModal()
    {
        isModalOpen = false;
    }

    private async Task OnBestiaGuardada()
    {
        isModalOpen = false;
        feedbackMessage = "Operación completada con éxito.";
        isFeedbackError = false;
        await CargarBestias();
    }

    private void AbrirModalEliminar()
    {
        if (selectedBestia != null)
        {
            isConfirmDeleteOpen = true;
        }
    }

    private async Task EliminarBestiaConfirmada()
    {
        if (selectedBestia == null) return;

        try
        {
            isConfirmDeleteOpen = false;
            isLoading = true;
            await BestiaApiClient.DeleteAsync(selectedBestia.Id);
            feedbackMessage = $"Bestia '{selectedBestia.Nombre}' eliminada.";
            isFeedbackError = false;
            selectedBestia = null;
            await CargarBestias();
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al eliminar bestia: {ex.Message}";
            isFeedbackError = true;
            isLoading = false;
        }
    }

    private void VerRegistrosDeBestia()
    {
        if (selectedBestia != null)
        {
            Navigation.NavigateTo($"/registros?bestiaId={selectedBestia.Id}");
        }
    }

    private bool isRegistroModalOpen = false;
    private FormMode registroModalMode = FormMode.Update;
    private RegistroDTO registroActual = new();

    private bool isPendientesModalOpen = false;
    private bool mostrandoTodosPendientes = false;
    private List<RegistroDTO> registrosPendientes = new();
    private bool isProcesandoPendiente = false;

    private async Task VerRegistroVigenteDeBestia()
    {
        if (selectedBestia == null) return;

        try
        {
            isLoading = true;
            feedbackMessage = null;
            var vigente = await RegistroApiClient.GetVigenteAsync(selectedBestia.Id);
            if (vigente == null)
            {
                if (Auth.IsAuthenticated)
                {
                    feedbackMessage = $"Aún no existen registros aprobados para '{selectedBestia.Nombre}'. Podés proponer el primer registro ahora.";
                    isFeedbackError = false;
                    registroActual = new RegistroDTO
                    {
                        IdBestia = selectedBestia.Id,
                        Estado = Auth.EsInvestigador ? "aprobado" : "pendiente",
                        Contenidos = new List<ContenidoRegistroDTO>()
                    };
                    registroModalMode = FormMode.Add;
                    isRegistroModalOpen = true;
                }
                else
                {
                    feedbackMessage = "Aún no existen registros aprobados para esta bestia.";
                    isFeedbackError = false;
                }
                return;
            }

            registroActual = vigente;
            registroModalMode = FormMode.Update;
            isRegistroModalOpen = true;
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al cargar el registro vigente: {ex.Message}";
            isFeedbackError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnRegistroModalSaved()
    {
        isRegistroModalOpen = false;
        feedbackMessage = Auth.EsInvestigador
            ? "Registro publicado/actualizado exitosamente."
            : "Propuesta de registro enviada para revisión (estado pendiente).";
        isFeedbackError = false;

        if (isPendientesModalOpen)
        {
            await RecargarPendientesActualesAsync();
        }
    }

    private async Task AbrirModalPendientes()
    {
        if (selectedBestia == null || !Auth.EsInvestigador) return;

        mostrandoTodosPendientes = false;
        isPendientesModalOpen = true;
        await CargarPendientesBestiaAsync(selectedBestia.Id);
    }

    private async Task AbrirModalTodosPendientes()
    {
        if (!Auth.EsInvestigador) return;

        mostrandoTodosPendientes = true;
        isPendientesModalOpen = true;
        await CargarTodosPendientesAsync();
    }

    private async Task RecargarPendientesActualesAsync()
    {
        if (mostrandoTodosPendientes)
        {
            await CargarTodosPendientesAsync();
        }
        else if (selectedBestia != null)
        {
            await CargarPendientesBestiaAsync(selectedBestia.Id);
        }
    }

    private async Task CargarTodosPendientesAsync()
    {
        try
        {
            isProcesandoPendiente = true;
            var acumulados = new List<RegistroDTO>();
            if (bestias != null)
            {
                foreach (var b in bestias)
                {
                    var regs = await RegistroApiClient.GetByBestiaAsync(b.Id);
                    acumulados.AddRange(regs.Where(r => r.Estado != null && r.Estado.Equals("pendiente", StringComparison.OrdinalIgnoreCase)));
                }
            }
            registrosPendientes = acumulados
                .OrderBy(r => bestias?.FirstOrDefault(b => b.Id == r.IdBestia)?.Nombre)
                .ThenBy(r => r.NroRegistro)
                .ToList();
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al cargar registros pendientes: {ex.Message}";
            isFeedbackError = true;
            registrosPendientes = new();
        }
        finally
        {
            isProcesandoPendiente = false;
        }
    }

    private async Task CargarPendientesBestiaAsync(Guid idBestia)
    {
        try
        {
            isProcesandoPendiente = true;
            var todos = await RegistroApiClient.GetByBestiaAsync(idBestia);
            registrosPendientes = todos
                .Where(r => r.Estado != null && r.Estado.Equals("pendiente", StringComparison.OrdinalIgnoreCase))
                .OrderBy(r => r.NroRegistro)
                .ToList();
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al cargar registros pendientes: {ex.Message}";
            isFeedbackError = true;
            registrosPendientes = new();
        }
        finally
        {
            isProcesandoPendiente = false;
        }
    }

    private void ExaminarPendiente(RegistroDTO reg)
    {
        registroActual = reg;
        registroModalMode = FormMode.Update;
        isRegistroModalOpen = true;
    }

    private async Task AceptarPendienteAsync(RegistroDTO reg)
    {
        if (!Auth.EsInvestigador || Auth.CurrentUser == null) return;
        try
        {
            isProcesandoPendiente = true;
            await RegistroApiClient.AprobarAsync(reg.IdBestia, reg.NroRegistro, Auth.CurrentUser.Id);
            feedbackMessage = $"Registro #{reg.NroRegistro} aprobado y publicado.";
            isFeedbackError = false;
            await RecargarPendientesActualesAsync();
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al aprobar registro: {ex.Message}";
            isFeedbackError = true;
        }
        finally
        {
            isProcesandoPendiente = false;
        }
    }

    private async Task RechazarPendienteAsync(RegistroDTO reg)
    {
        if (!Auth.EsInvestigador) return;
        try
        {
            isProcesandoPendiente = true;
            await RegistroApiClient.DeleteAsync(reg.IdBestia, reg.NroRegistro);
            feedbackMessage = $"Registro #{reg.NroRegistro} rechazado y eliminado.";
            isFeedbackError = false;
            await RecargarPendientesActualesAsync();
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al rechazar registro: {ex.Message}";
            isFeedbackError = true;
        }
        finally
        {
            isProcesandoPendiente = false;
        }
    }
}

<Blazor.Server.Pages.Registros.RegistroModal
    IsOpen="@isRegistroModalOpen"
    Mode="@registroModalMode"
    Registro="@registroActual"
    Bestias="@(bestias ?? new List<BestiaDTO>())"
    OnSaved="@OnRegistroModalSaved"
    OnCancel="@(() => isRegistroModalOpen = false)" />

@if (isPendientesModalOpen)
{
    <div class="win-modal-overlay">
        <div class="win-modal-dialog" style="width: 720px; max-width: 95vw;">
            <div class="win-titlebar">
                <div class="d-flex align-items-center gap-1">
                    <span class="oi oi-clock text-warning" style="font-size: 11px;"></span>
                    <span>@(mostrandoTodosPendientes ? "Todos los Registros Pendientes" : $"Registros Pendientes — {selectedBestia?.Nombre ?? "-"}")</span>
                </div>
                <div class="win-titlebar-controls">
                    <button class="win-titlebar-btn close" @onclick="@(() => isPendientesModalOpen = false)">✕</button>
                </div>
            </div>
            <div class="win-form-content" style="padding: 12px 16px;">
                @if (isProcesandoPendiente)
                {
                    <div class="text-muted py-3 text-center" style="font-size: 12px;">Cargando...</div>
                }
                else if (!registrosPendientes.Any())
                {
                    <div class="text-muted py-3 text-center" style="font-size: 12px;">
                        @(mostrandoTodosPendientes ? "No hay registros pendientes en el sistema." : "No hay registros pendientes para esta bestia.")
                    </div>
                }
                else
                {
                    <div class="win-grid-container" style="height: 230px;">
                        <table class="win-grid">
                            <thead>
                                <tr>
                                    <th>Bestia</th>
                                    <th style="width: 70px;">Nro.</th>
                                    <th>Publicador</th>
                                    <th style="width: 75px;">Secc.</th>
                                    <th style="width: 220px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reg in registrosPendientes)
                                {
                                    var bName = bestias?.FirstOrDefault(b => b.Id == reg.IdBestia)?.Nombre ?? reg.IdBestia.ToString().Substring(0, 8);
                                    <tr>
                                        <td><strong>@bName</strong></td>
                                        <td>#@reg.NroRegistro</td>
                                        <td style="font-size: 11px;">@(reg.CorreoPublicador ?? "-")</td>
                                        <td>@reg.Contenidos.Count</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <button class="win-btn" style="height: 20px; font-size: 10px;" @onclick="() => ExaminarPendiente(reg)">Examinar</button>
                                                <button class="win-btn text-success" style="height: 20px; font-size: 10px;" @onclick="() => AceptarPendienteAsync(reg)">Aceptar</button>
                                                <button class="win-btn text-danger" style="height: 20px; font-size: 10px;" @onclick="() => RechazarPendienteAsync(reg)">Rechazar</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <div class="d-flex justify-content-end mt-3 pt-2 border-top">
                    <button class="win-btn" @onclick="@(() => isPendientesModalOpen = false)">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

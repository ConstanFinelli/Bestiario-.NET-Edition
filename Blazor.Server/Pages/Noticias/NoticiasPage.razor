@page "/noticias"
@using DTOs
@using API.Clients
@inject NavigationManager Navigation
@inject AuthService Auth

<PageTitle>Bestiario - Noticias</PageTitle>

<section class="mainContent">
    <h2 style="font-size: 2rem; margin-bottom: 20px;">NOTICIAS</h2>

    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="notFound" style="margin-bottom: 1rem;">@feedbackMessage</div>
    }

    @if (Auth.IsInvestigador)
    {
        <div style="margin-bottom: 20px;">
            <a class="btnAgregar" href="/noticias/redactar">+ Redactar nueva noticia</a>
        </div>
    }

    @if (isLoading)
    {
        <div class="notFound">Cargando noticias...</div>
    }
    else if (noticias == null || !noticias.Any())
    {
        <div class="notFound">
            No hay noticias cargadas por el momento.
        </div>
    }
    else
    {
        <div class="newsContainer">
            @foreach (var noticia in noticias)
            {
                <article class="new">
                    <div class="newContainer">
                        <h2>@noticia.Titulo</h2>
                        <span class="newInfo">
                            publicado @noticia.FechaPublicacion.ToString("dd/MM/yyyy HH:mm")
                        </span>
                        <p class="newContent">
                            @noticia.Contenido
                        </p>

                        @if (Auth.IsInvestigador)
                        {
                            <button type="button" class="btnEliminarNoticia" @onclick="() => AbrirConfirmarEliminar(noticia)">
                                Eliminar
                            </button>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

<!-- Modal Confirmación Eliminación -->
<div class="modal-container @(isModalEliminarVisible ? "is-visible" : "")">
    <div class="modal-content">
        <h2 id="modal-titulo">ELIMINAR NOTICIA</h2>
        <div id="modal-cuerpo" style="font-size: 1.2rem; text-align: center;">
            ¿Estás seguro que deseas eliminar la noticia <strong>@noticiaAEliminar?.Titulo</strong>?
        </div>
        <div class="modalButtons">
            <button type="button" class="closeButton" @onclick="CerrarModalEliminar">Cancelar</button>
            <button type="button" class="deleteButton" @onclick="ConfirmarEliminar">Eliminar</button>
        </div>
    </div>
</div>

@code {
    private List<NoticiaDTO> noticias = new();
    private bool isLoading = true;
    private string? feedbackMessage;

    private bool isModalEliminarVisible = false;
    private NoticiaDTO? noticiaAEliminar;

    protected override async Task OnInitializedAsync()
    {
        await CargarNoticias();
    }

    private async Task CargarNoticias()
    {
        try
        {
            isLoading = true;
            feedbackMessage = null;
            var result = await NoticiaApiClient.GetAllAsync();
            noticias = result?.OrderByDescending(n => n.FechaPublicacion).ToList() ?? new List<NoticiaDTO>();
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al cargar noticias: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AbrirConfirmarEliminar(NoticiaDTO n)
    {
        noticiaAEliminar = n;
        isModalEliminarVisible = true;
    }

    private void CerrarModalEliminar()
    {
        isModalEliminarVisible = false;
        noticiaAEliminar = null;
    }

    private async Task ConfirmarEliminar()
    {
        if (noticiaAEliminar == null) return;

        try
        {
            isModalEliminarVisible = false;
            isLoading = true;
            await NoticiaApiClient.DeleteAsync(noticiaAEliminar.Id);
            feedbackMessage = $"Noticia '{noticiaAEliminar.Titulo}' eliminada.";
            noticiaAEliminar = null;
            await CargarNoticias();
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al eliminar noticia: {ex.Message}";
            isLoading = false;
        }
    }
}

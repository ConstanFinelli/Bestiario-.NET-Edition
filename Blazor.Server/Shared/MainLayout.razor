@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Navigation
@implements IDisposable

<div class="desktop-container">
    <!-- Ventana Principal que contiene el Sistema -->
    <div class="desktop-work-area">
        @Body
    </div>

    <!-- Barra de Tareas Inferior (Estilo Windows) -->
    <div class="desktop-taskbar">
        <div class="d-flex align-items-center gap-2 me-auto">
            <NavLink href="/" class="btn btn-sm btn-light border d-flex align-items-center gap-1 shadow-sm px-2">
                <span class="oi oi-grid-four-up text-primary"></span>
                <strong>Bestiario .NET</strong>
            </NavLink>
            <span class="text-secondary small ms-2">Edición Blazor Server (.NET 8)</span>
        </div>

        <div class="d-flex align-items-center gap-3">
            <span class="badge bg-light text-dark border">
                <span class="oi oi-hard-drive me-1 text-success"></span> API: localhost:5076
            </span>

            @if (Auth.IsAuthenticated)
            {
                <span class="badge bg-primary">
                    <span class="oi oi-person me-1"></span> @Auth.Username
                </span>
                <button class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 11px;" @onclick="CerrarSesion">
                    Cerrar sesión
                </button>
            }
            else
            {
                <span class="badge bg-secondary">
                    <span class="oi oi-person me-1"></span> Modo Invitado
                </span>
                <NavLink href="/login" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 11px;">
                    Iniciar sesión
                </NavLink>
            }

            <span class="text-muted small">
                @DateTime.Now.ToString("HH:mm")
            </span>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Auth.OnChange += OnAuthStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Auth.InitializeAsync();
            VerificarAutenticacion();
        }
    }

    protected override void OnParametersSet()
    {
        VerificarAutenticacion();
    }

    private void VerificarAutenticacion()
    {
        // Se permite acceso público a las vistas en Modo Invitado
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(() =>
        {
            VerificarAutenticacion();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Auth.OnChange -= OnAuthStateChanged;
    }

    private void CerrarSesion()
    {
        Auth.Logout();
        Navigation.NavigateTo("/login");
    }
}

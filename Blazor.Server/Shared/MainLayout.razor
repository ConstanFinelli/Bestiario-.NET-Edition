@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Navigation
@implements IDisposable

@if (IsBarePage)
{
    @Body
}
else
{
    <nav>
        <NavLink class="navTitle" href="/">Bestiario</NavLink>
        <NavLink class="navLink" href="/bestias">Bestias</NavLink>
        <NavLink class="navLink" href="/mapa">Mapa</NavLink>
        <NavLink class="navLink" href="/noticias">Noticias</NavLink>

        @if (Auth.IsAuthenticated)
        {
            @if (Auth.IsInvestigador)
            {
                <NavLink class="navLink" href="/admin">Admin</NavLink>
                <NavLink class="navLink" href="/investigadores/solicitudes">Candidaturas</NavLink>
            }
            else if (Auth.IsLector)
            {
                <NavLink class="navLink" href="/investigadores/candidatura">Volverse Investigador</NavLink>
            }

            <button type="button" class="logInOut" @onclick="CerrarSesion">Cerrar sesión</button>
        }
        else
        {
            <button type="button" class="logInOut" @onclick="IrALogin">Iniciar Sesion</button>
        }
    </nav>

    @Body

    <footer>
        <p>© 2026 Bestiario S.A. Todos los derechos reservados.</p>
    </footer>
}

@code {
    private bool IsBarePage
    {
        get
        {
            var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
            int queryIndex = relativePath.IndexOf('?');
            if (queryIndex >= 0)
            {
                relativePath = relativePath.Substring(0, queryIndex);
            }

            return relativePath.Equals("login", StringComparison.OrdinalIgnoreCase) ||
                   relativePath.Equals("register", StringComparison.OrdinalIgnoreCase) ||
                   relativePath.StartsWith("auth/", StringComparison.OrdinalIgnoreCase) ||
                   relativePath.Equals("mapa", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override void OnInitialized()
    {
        Auth.OnChange += OnAuthStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Auth.InitializeAsync();
        }
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Auth.OnChange -= OnAuthStateChanged;
    }

    private void IrALogin()
    {
        Navigation.NavigateTo("/login");
    }

    private async Task CerrarSesion()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/");
    }
}

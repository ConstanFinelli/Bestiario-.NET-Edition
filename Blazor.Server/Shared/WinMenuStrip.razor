<div class="win-menustrip">
    <NavLink href="/" class="win-menu-item" Match="NavLinkMatch.All">
        Inicio
    </NavLink>
    <NavLink href="/categorias" class="win-menu-item">
        Categorias
    </NavLink>
    <NavLink href="/noticias" class="win-menu-item">
        Noticias
    </NavLink>
    <NavLink href="/bestias" class="win-menu-item">
        Bestias
    </NavLink>
    <NavLink href="/registros" class="win-menu-item">
        Registros
    </NavLink>
    <NavLink href="/habitats" class="win-menu-item">
        Hábitats
    </NavLink>
    <NavLink href="/tipos-evidencia" class="win-menu-item">
        Tipos Evidencia
    </NavLink>
    @if (OnRefresh.HasDelegate)
    {
        <div class="ms-auto">
            <button class="win-btn" style="height: 20px; font-size: 11px; padding: 0 6px;" @onclick="OnRefresh" disabled="@IsLoading">
                Refrescar
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public bool IsLoading { get; set; }
}

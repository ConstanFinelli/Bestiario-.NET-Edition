@if (IsOpen)
{
    <div class="win-modal-overlay">
        <div class="win-modal-dialog win-modal-confirm">
            <!-- Barra de Título MessageBox -->
            <div class="win-titlebar">
                <div class="d-flex align-items-center gap-1">
                    <span class="oi oi-warning text-primary win-title-icon"></span>
                    <span>@Title</span>
                </div>
                <div class="win-titlebar-controls">
                    <button class="win-titlebar-btn close" title="Cerrar" @onclick="Cancel">✕</button>
                </div>
            </div>

            <!-- Cuerpo del MessageBox -->
            <div class="win-form-content win-confirm-body">
                <div class="d-flex align-items-start gap-3 mb-4">
                    <div class="win-confirm-icon">
                        <span class="oi oi-question-mark"></span>
                    </div>
                    <div class="flex-grow-1 win-confirm-msg">
                        @Message
                    </div>
                </div>

                <!-- Botones Sí / No estilo MessageBox Windows Forms -->
                <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                    <button type="button" class="win-btn" @onclick="Confirm">
                        Sí
                    </button>
                    <button type="button" class="win-btn" @onclick="Cancel">
                        No
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "Confirmar eliminación";
    [Parameter] public string Message { get; set; } = "¿Está seguro que desea realizar esta acción?";
    [Parameter] public string ConfirmButtonText { get; set; } = "Sí";

    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task Confirm()
    {
        await OnConfirm.InvokeAsync();
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }
}
